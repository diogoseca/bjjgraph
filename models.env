# =============================================================================
# models.env — THE single source of truth for which Claude model this repo uses.
# =============================================================================
#
# Every automated Claude call in this repo (content regeneration, proofreading,
# calibration, clip sourcing, MC authoring, the GitHub bots) resolves its model
# from here. Change a line, and every caller follows on its next run. Nothing
# else needs editing — there is deliberately no second list.
#
# HOW CALLERS READ THIS
#   Python : from _model import model, effort  ->  model()  /  model("deep")
#   Shell  : set -a; . ./models.env; set +a    ->  "$BJJ_CLAUDE_MODEL"
#   Either : python3 scripts/_model.py --print default
#
# ONE-OFF OVERRIDE (no edit, no commit) — env wins over this file:
#   BJJ_CLAUDE_MODEL=claude-fable-5 npm run regenerate:json
#
# TIERS — callers name a tier, never a model ID. Keep it to these three; a
# fourth tier means a fourth thing to remember, which is the problem this file
# exists to solve.
#
#   default  the workhorse: content generation, proofreading, calibration
#   deep     hardest reasoning where cost is not the constraint (curriculum)
#   fast     high-volume mechanical passes where the tier is plenty
#
# Valid IDs are the exact strings from Anthropic's model list — no date
# suffixes. Opus 5 carries a 1M context window by default, so the older
# `[1m]` CLI variant suffix (needed on Opus 4.8) is neither used nor wanted.
# `scripts/_model.py --audit` fails if an ID here looks malformed or if any
# script has gone back to hardcoding one.

BJJ_CLAUDE_MODEL=claude-opus-5
BJJ_CLAUDE_MODEL_DEEP=claude-fable-5
BJJ_CLAUDE_MODEL_FAST=claude-sonnet-5

# Reasoning effort for the default tier (low|medium|high|xhigh|max).
# Content work is quality-critical and intermittent, so we run near the top.
BJJ_CLAUDE_EFFORT=xhigh
