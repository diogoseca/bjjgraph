{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BJJ Position Template Schema V3",
  "description": "Standardized JSON schema for BJJ position pages - strict 15-section structure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "overview",
    "state_properties",
    "state_invariants",
    "prerequisites",
    "key_principles",
    "offensive_transitions",
    "defensive_responses",
    "counter_transitions",
    "decision_tree",
    "common_errors",
    "training_drills",
    "optimal_submission_paths",
    "related_content",
    "position_metrics",
    "expert_insights"
  ],

  "properties": {
    "metadata": {
      "type": "object",
      "description": "Page metadata and SEO information",
      "additionalProperties": false,
      "required": ["title", "description", "state_id", "tags"],
      "properties": {
        "title": {
          "type": "string",
          "description": "SEO title format: '[Position Name] | BJJ Position Guide | BJJ Graph'",
          "pattern": "^.+ \\| BJJ Position Guide \\| BJJ Graph$",
          "examples": ["Mount"]
        },
        "description": {
          "type": "string",
          "description": "Meta description 140-180 characters (SEO optimal: 150-160)",
          "minLength": 140,
          "maxLength": 180,
          "examples": ["Master Mount position in BJJ. Complete guide covering control, submissions, and transitions. Dominant 
4-point position with 75% retention rate."]
        },
        "state_id": {
          "type": "string",
          "description": "Unique state identifier S###",
          "pattern": "^S[0-9]{3}$",
          "examples": ["S004", "S095"]
        },
        "tags": {
          "type": "array",
          "description": "Content tags (minimum 3)",
          "minItems": 3,
          "items": {"type": "string"},
          "examples": [["bjj", "position", "mount", "dominant"]]
        },
        "parent_variant": {
          "type": "string",
          "description": "Parent position if this is a child variant (e.g., 'Mount' for 'Mount Top')",
          "examples": ["Mount", "Side Control", "Back Control"]
        },
        "sibling_variants": {
          "type": "array",
          "description": "Other child variants of same parent (excluding self)",
          "items": {"type": "string"},
          "minItems": 1,
          "maxItems": 11,
          "examples": [["Mount Bottom"], ["Side Control Top"]]
        },
        "child_variants": {
          "type": "array",
          "description": "All child variants if this is a parent position (e.g., for 'Mount': ['Mount Top', 'Mount Bottom'])",
          "items": {"type": "string"},
          "minItems": 1,
          "maxItems": 12,
          "examples": [["Mount Top", "Mount Bottom"], ["Side Control Top", "Side Control Bottom"]]
        }
      }
    },

    "overview": {
      "type": "string",
      "description": "2-3 paragraph position description with strategic context (renamed from 'State Description')",
      "minLength": 400,
      "examples": ["Mount is a premier controlling position in BJJ where the top practitioner sits astride the opponent's 
torso..."]
    },

    "state_properties": {
      "type": "object",
      "description": "Core state machine properties",
      "additionalProperties": false,
      "required": ["point_value", "position_type", "risk_level", "energy_cost", "time_sustainability"],
      "properties": {
        "point_value": {
          "type": "integer",
          "description": "IBJJF points (0=neutral, 2=advantage, 3=pass, 4=mount/back)",
          "minimum": 0,
          "maximum": 4
        },
        "position_type": {
          "type": "string",
          "enum": ["Offensive", "Defensive", "Neutral", "Controlling", "Offensive/Controlling", "Defensive with offensive 
options"]
        },
        "risk_level": {
          "type": "string",
          "enum": ["Low", "Medium", "High", "Low to Medium"]
        },
        "energy_cost": {
          "type": "string",
          "enum": ["Low", "Medium", "High"]
        },
        "time_sustainability": {
          "type": "string",
          "enum": ["Short", "Medium", "Long", "Short to Medium", "Medium to Long"]
        }
      }
    },

    "state_invariants": {
      "type": "array",
      "description": "Conditions that must remain true - WITH anatomical/visual detail (merges Visual Description)",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 50,
        "description": "Each invariant describes positioning with anatomical detail"
      },
      "examples": [[
        "Hips positioned on opponent's torso/abdomen with direct weight distribution through pelvis and lower body",
        "Both knees on the ground on either side of opponent with tight connection to ribs/armpits, eliminating space",
        "Opponent on their back with shoulders flat to mat, facing upward toward top player with limited mobility"
      ]]
    },

    "prerequisites": {
      "type": "array",
      "description": "Conditions that must be true before entering this position",
      "minItems": 3,
      "items": {"type": "string"},
      "examples": [[
        "Successful pass from side control, guard, or other position",
        "Control of opponent's upper body",
        "Opponent flat on back"
      ]]
    },

    "key_principles": {
      "type": "array",
      "description": "5-7 fundamental principles (standardized name)",
      "minItems": 5,
      "maxItems": 7,
      "items": {"type": "string"},
      "examples": [[
        "Keep knees tight to opponent's ribs/armpits",
        "Maintain low center of gravity with hips sinking into opponent's diaphragm",
        "Distribute weight through hips, not hands"
      ]]
    },

    "offensive_transitions": {
      "type": "array",
      "description": "Available attacks/advancements from this position",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["technique", "target_position", "success_rates"],
        "properties": {
          "technique": {
            "type": "string",
            "description": "Technique name (wikilink format)"
          },
          "target_position": {
            "type": "string",
            "description": "Resulting position (wikilink format)"
          },
          "success_rates": {
            "$ref": "#/$defs/skill_level_success_rates"
          }
        }
      }
    },

    "defensive_responses": {
      "type": "array",
      "description": "How opponent defends when you have this position",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["technique", "target_position"],
        "properties": {
          "technique": {"type": "string"},
          "target_position": {"type": "string"},
          "success_rate": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Optional: opponent's success rate for this escape"
          }
        }
      }
    },

    "counter_transitions": {
      "type": "array",
      "description": "Transitions to counter opponent's escape attempts",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["technique", "target_position", "trigger"],
        "properties": {
          "technique": {"type": "string"},
          "target_position": {"type": "string"},
          "trigger": {
            "type": "string",
            "description": "What opponent action triggers this counter"
          }
        }
      }
    },

    "decision_tree": {
      "type": "array",
      "description": "If/else logic for state transitions",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["condition", "actions"],
        "properties": {
          "condition": {
            "type": "string",
            "description": "If/else if condition describing opponent behavior"
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["technique", "target", "probability"],
              "properties": {
                "technique": {"type": "string"},
                "target": {"type": "string"},
                "probability": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            }
          }
        }
      }
    },

    "common_errors": {
      "type": "array",
      "description": "5+ common mistakes with corrections",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error", "consequence", "correction"],
        "properties": {
          "error": {"type": "string"},
          "consequence": {"type": "string"},
          "correction": {"type": "string"}
        }
      }
    },

    "training_drills": {
      "type": "array",
      "description": "3+ drills to practice this position",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description"],
        "properties": {
          "name": {"type": "string"},
          "description": {"type": "string"},
          "duration": {
            "type": "string",
            "description": "Optional drill duration"
          }
        }
      }
    },

    "optimal_submission_paths": {
      "type": "array",
      "description": "3+ paths from this position to submission",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Path description (e.g., 'Shortest path', 'High-percentage path')"
          },
          "path": {
            "type": "string",
            "description": "Sequence of positions/techniques with → arrows"
          }
        }
      }
    },

    "related_content": {
      "type": "array",
      "description": "Related positions/states/techniques (merged: Related Positions + Related States)",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "relationship"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Related content name (wikilink format)"
          },
          "relationship": {
            "type": "string",
            "description": "How it relates (e.g., 'Variation', 'Transition target', 'Similar position')"
          }
        }
      }
    },

    "position_metrics": {
      "type": "object",
      "description": "Success rates, retention rates, probabilities",
      "additionalProperties": false,
      "required": ["retention_rate", "advancement_probability", "submission_probability"],
      "properties": {
        "retention_rate": {
          "$ref": "#/$defs/skill_level_success_rates",
          "description": "Position retention by skill level"
        },
        "advancement_probability": {
          "$ref": "#/$defs/skill_level_success_rates",
          "description": "Probability of advancing to better position"
        },
        "submission_probability": {
          "$ref": "#/$defs/skill_level_success_rates",
          "description": "Probability of finishing from this position"
        },
        "average_time": {
          "type": "string",
          "description": "Average time spent in position (optional)",
          "examples": ["1-2 minutes", "30-60 seconds"]
        }
      }
    },

    "expert_insights": {
      "type": "object",
      "description": "Insights from all 3 experts (REQUIRED, 200+ chars each)",
      "additionalProperties": false,
      "required": ["danaher", "gordon_ryan", "eddie_bravo"],
      "properties": {
        "danaher": {
          "type": "string",
          "minLength": 200,
          "description": "John Danaher - systematic/biomechanical perspective"
        },
        "gordon_ryan": {
          "type": "string",
          "minLength": 200,
          "description": "Gordon Ryan - competition/practical application"
        },
        "eddie_bravo": {
          "type": "string",
          "minLength": 200,
          "description": "Eddie Bravo - innovation/10th Planet approach"
        }
      }
    }
  },

  "$defs": {
    "skill_level_success_rates": {
      "type": "object",
      "description": "Success rates by skill level - REQUIRED with validation (beginner ≤ intermediate ≤ advanced)",
      "additionalProperties": false,
      "required": ["beginner", "intermediate", "advanced"],
      "properties": {
        "beginner": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Success rate for beginner practitioners"
        },
        "intermediate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Success rate for intermediate practitioners"
        },
        "advanced": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Success rate for advanced practitioners"
        }
      }
    }
  }
}
