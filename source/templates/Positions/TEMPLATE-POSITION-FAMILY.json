{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bjjgraph.org/schemas/position-family.json",
  "title": "BJJ Position Family Schema",
  "description": "JSON Schema for position families WITH variations (Mount, Guards, etc.). Generates hub page + bottom page + top page.",
  "type": "object",
  "required": [
    "name",
    "slug",
    "description",
    "variant_uniqueness",
    "overview",
    "key_principles",
    "variations",
    "related_positions",
    "bottom",
    "top"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Position family name (e.g., 'Mount', 'Closed Guard')",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly slug (e.g., 'mount', 'closed-guard')",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "description": "SEO meta description (150-160 characters)",
      "minLength": 150,
      "maxLength": 160
    },
    "variant_uniqueness": {
      "type": "string",
      "description": "What makes this variant unique - strategic trade-off explanation (20-50 characters)",
      "minLength": 20,
      "maxLength": 50
    },
    "overview": {
      "type": "string",
      "description": "Comprehensive overview of the position family (400+ words minimum)",
      "minLength": 400
    },
    "key_principles": {
      "type": "array",
      "description": "Core principles that apply across all variations",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "variations": {
      "type": "array",
      "description": "List of position variations (required for FAMILY template)",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "slug",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Variation name - MUST match filename exactly (Title Case, spaces, apostrophes kept, numbers preserved)",
            "minLength": 1,
            "examples": ["High Mount", "S Mount Position", "Technical Mount", "3-4 Mount", "Mounted Crucifix"]
          },
          "slug": {
            "type": "string",
            "description": "URL slug - lowercase with spaces→hyphens, apostrophes removed ('High Mount'→'high-mount')",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "examples": ["high-mount", "s-mount-position", "technical-mount", "3-4-mount", "mounted-crucifix"]
          },
          "description": {
            "type": "string",
            "description": "Brief variation description (10-80 chars)",
            "minLength": 10,
            "maxLength": 80
          }
        },
        "additionalProperties": false
      }
    },
    "related_positions": {
      "type": "array",
      "description": "Related positions with relationship descriptions",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "relationship"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Related position name",
            "minLength": 1
          },
          "relationship": {
            "type": "string",
            "description": "How this position relates to the main position",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "bottom": {
      "type": "object",
      "description": "Bottom perspective configuration",
      "required": [
        "overview",
        "state_properties",
        "state_invariants",
        "prerequisites",
        "key_principles",
        "offensive_transitions",
        "defensive_responses",
        "counter_transitions",
        "decision_tree",
        "common_errors",
        "training_drills",
        "optimal_submission_paths",
        "related_content",
        "position_metrics",
        "expert_insights",
        "name",
        "description",
        "tags"
      ],
      "properties": {
        "overview": {
          "type": "string",
          "description": "Position overview from bottom perspective (400+ words minimum)",
          "minLength": 400
        },
        "state_properties": {
          "type": "object",
          "required": [
            "point_value",
            "position_type",
            "risk_level",
            "energy_cost",
            "time_sustainability"
          ],
          "properties": {
            "point_value": {
              "type": "integer",
              "description": "IBJJF point value (negative for bottom positions)",
              "minimum": -4,
              "maximum": 4
            },
            "position_type": {
              "type": "string",
              "enum": [
                "Offensive",
                "Defensive",
                "Neutral",
                "Offensive/Controlling"
              ]
            },
            "risk_level": {
              "type": "string",
              "enum": [
                "Low",
                "Medium",
                "High"
              ]
            },
            "energy_cost": {
              "type": "string",
              "enum": [
                "Low",
                "Medium",
                "High"
              ]
            },
            "time_sustainability": {
              "type": "string",
              "enum": [
                "Short",
                "Medium",
                "Long"
              ]
            }
          },
          "additionalProperties": false
        },
        "state_invariants": {
          "type": "array",
          "description": "Defining characteristics that must be true for this position",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "prerequisites": {
          "type": "array",
          "description": "Required knowledge/skills for this position",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "key_principles": {
          "type": "array",
          "description": "Core principles for this position (5-7 principles)",
          "minItems": 5,
          "maxItems": 7,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "offensive_transitions": {
          "type": "array",
          "description": "Available attacking transitions (minimum 6)",
          "minItems": 6,
          "items": {
            "type": "object",
            "required": [
              "technique",
              "target_position",
              "success_rates"
            ],
            "properties": {
              "technique": {
                "type": "string",
                "description": "Technique name",
                "minLength": 1
              },
              "target_position": {
                "type": "string",
                "description": "Resulting position",
                "minLength": 1
              },
              "success_rates": {
                "type": "object",
                "required": [
                  "beginner",
                  "intermediate",
                  "advanced"
                ],
                "properties": {
                  "beginner": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "intermediate": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "advanced": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "defensive_responses": {
          "type": "array",
          "description": "Opponent's typical responses (minimum 4)",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": [
              "technique",
              "target_position",
              "success_rate"
            ],
            "properties": {
              "technique": {
                "type": "string",
                "minLength": 3
              },
              "target_position": {
                "type": "string",
                "minLength": 3
              },
              "success_rate": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            },
            "additionalProperties": false
          }
        },
        "counter_transitions": {
          "type": "array",
          "description": "Situational counter-techniques",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "technique",
              "target_position",
              "trigger"
            ],
            "properties": {
              "technique": {
                "type": "string",
                "minLength": 3
              },
              "target_position": {
                "type": "string",
                "minLength": 3
              },
              "trigger": {
                "type": "string",
                "description": "When to use this counter",
                "minLength": 10
              }
            },
            "additionalProperties": false
          }
        },
        "decision_tree": {
          "type": "array",
          "description": "Decision tree with conditions and actions (minimum 3 conditions)",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "condition",
              "actions"
            ],
            "properties": {
              "condition": {
                "type": "string",
                "description": "If/when condition",
                "minLength": 10
              },
              "actions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "technique",
                    "target",
                    "probability"
                  ],
                  "properties": {
                    "technique": {
                      "type": "string",
                      "minLength": 3
                    },
                    "target": {
                      "type": "string",
                      "minLength": 3
                    },
                    "probability": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "common_errors": {
          "type": "array",
          "description": "Common mistakes with corrections (minimum 5)",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": [
              "error",
              "consequence",
              "correction"
            ],
            "properties": {
              "error": {
                "type": "string",
                "minLength": 10
              },
              "consequence": {
                "type": "string",
                "minLength": 10
              },
              "correction": {
                "type": "string",
                "minLength": 10
              }
            },
            "additionalProperties": false
