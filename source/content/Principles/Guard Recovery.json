  "common_errors": [
    {
      "error": "Going flat on back and stopping hip movement",
      "consequence": "Allows opponent to consolidate passing position with settled weight and pressure, making recovery nearly impossible",
      "correction": "Maintain constant hip mobility through continuous shrimping, bridging, or turning even when exhausted - movement creates recovery windows"
    },
    {
      "error": "Giving up frames too early to grab legs or chase opponent's body",
      "consequence": "Allows opponent's chest to connect to your chest, eliminating space needed for guard recovery and leading to immediate side control",
      "correction": "Maintain forearm frames or knee shields until new leg position is established - frames are more important than leg attacks during recovery"
    },
    {
      "error": "Turning away from opponent to escape pressure",
      "consequence": "Exposes back and allows opponent to take back control or secure turtle position where recovery options are more limited",
      "correction": "Always face opponent during guard recovery sequences - use Granby rolls only when necessary and immediately recover guard-facing position"
    },
    {
      "error": "Attempting to recover the same guard that was just passed",
      "consequence": "Wastes time and energy trying to rebuild a structure opponent has already defeated, allowing them to advance position",
      "correction": "Focus on establishing any functional guard structure rather than chasing the specific guard you lost - half guard recovery is often easier than rebuilding open guard"
    },
    {
      "error": "Using only arm strength to push opponent away",
      "consequence": "Rapidly depletes energy while failing to create meaningful space since legs are not involved in the defensive frame",
      "correction": "Combine upper body frames with hip movement and leg reentry - recovery requires full-body coordination not just pushing with arms"
    },
    {
      "error": "Accepting inferior position to avoid exhaustion",
      "consequence": "Allows opponent to consolidate dominant positions that lead to point deficits and submission opportunities",
      "correction": "Guard recovery requires maximum effort output for short bursts - better to exhaust yourself attempting recovery than to give up position easily"
    },
    {
      "error": "Failing to protect against crossface during recovery attempts",
      "consequence": "Allows opponent to control head and shoulders, preventing hip mobility and making all guard recovery techniques ineffective",
      "correction": "Maintain near-side arm frame to block crossface attempts while using hip movement - protect head position as priority during recovery sequences"
    }
  ],
