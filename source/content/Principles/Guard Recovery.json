  "common_errors": [
    {
      "error": "Standing upright or raising chest too high while attempting to pass",
      "consequence": "Creates space underneath allowing opponent to insert legs and recover guard structure",
      "correction": "Maintain heavy chest pressure and low posture, keeping hips driving forward and connection to opponent's torso"
    },
    {
      "error": "Focusing only on clearing legs without controlling opponent's hips and shoulders",
      "consequence": "Opponent easily shrimps away and recovers distance needed to reinsert guard",
      "correction": "Prioritize controlling the center of mass (hips) and limiting head mobility with crossface before attempting to advance"
    },
    {
      "error": "Remaining static in guard recovery position without transitioning to consolidated control",
      "consequence": "Gives opponent time to problem-solve and eventually recover guard as energy depletes",
      "correction": "Recognize this as a transitional position and immediately advance to side control, mount, or other stable position"
    },
    {
      "error": "Pulling or lifting on opponent's legs trying to remove them forcefully",
      "consequence": "Creates reactionary space as opponent pushes back, often resulting in sudden guard recovery",
      "correction": "Circle around legs while maintaining torso connection, using hip pressure rather than arm strength"
    },
    {
      "error": "Overcommitting weight to one side allowing opponent to roll or reverse",
      "consequence": "Opponent uses momentum to complete sweep or scramble back to neutral position",
      "correction": "Maintain balanced weight distribution with active base, ready to adjust as opponent shifts"
    },
    {
      "error": "Hesitating or waiting for perfect passing opportunity",
      "consequence": "Opponent uses time to improve position incrementally, recovering frames and eventually full guard",
      "correction": "Act decisively with committed forward pressure, making micro-adjustments while maintaining offensive momentum"
    },
    {
      "error": "Ignoring opponent's grips and allowing control of sleeves or collar",
      "consequence": "Opponent uses grips to create frames, off-balance top player, and recover guard structure",
      "correction": "Break or control opponent's grips immediately, fighting for inside position and dominant hand placement"
    }
  ],

