  "common_errors": [
    {
      "error": "Insufficient shoulder pressure with weight on neck",
      "consequence": "Risk of neck injury and inability to maintain position or create rotation",
      "correction": "Distribute weight across shoulder blades, keep head tucked, and actively press shoulders into mat while lifting hips"
    },
    {
      "error": "Poor weight distribution allowing opponent to flatten guard",
      "consequence": "Loss of mobility and defensive capability, making smash passes highly effective",
      "correction": "Maintain active hip elevation and rotation, never allowing hips to settle flat to mat"
    },
    {
      "error": "Overextension of legs without maintaining connection",
      "consequence": "Loss of control over opponent's movement and inability to prevent passing or apply offensive techniques",
      "correction": "Keep legs engaged with hooks or foot placement on opponent's hips, belt, or legs while maintaining grip controls"
    },
    {
      "error": "Extended time in inverted position without transitional intent",
      "consequence": "Excessive energy expenditure and increased vulnerability to stack passes and pressure",
      "correction": "Use inversion as transitional position, immediately moving to berimbolo, back take, or guard recovery rather than static holding"
    },
    {
      "error": "Lack of clear transitional intent or pathway",
      "consequence": "Stalling in position without offensive or defensive purpose, leading to referee penalties or successful passes",
      "correction": "Always have clear objective when inverting: either entering leg entanglement, setting up back take, or recovering guard position"
    },
    {
      "error": "Failing to protect against stack passes",
      "consequence": "Opponent drives weight onto shoulders and neck, creating severe pressure and passing opportunities",
      "correction": "Recognize stacking attempts early and immediately granby roll or rotate to alleviate pressure and re-establish guard"
    }
  ],
