    },
    {
      "name": "Submission Chains from High Mount",
      "description": "Drill armbar to Ezekiel to collar choke sequences, practicing fluid transitions between attacks based on opponent's defensive reactions. Partner defends realistically, forcing attacker to read defenses and chain submissions appropriately.",
      "duration": "3 minutes per round, 5 rounds"
    },
    {
      "name": "Mount Retention Against Escapes",
      "description": "Partner attempts bridges, shrimps, and frame-based escapes while you maintain high mount, developing sensitivity to escape attempts and automatic counters. Progress from slow motion to full resistance over multiple rounds.",
