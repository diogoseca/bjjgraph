  "common_errors": [
    {
      "error": "Locking body triangle too high on ribs or chest",
      "consequence": "Can cause injury to training partner through rib compression, reduces attacker's mobility for submissions, and creates legal issues in some competition rulesets that prohibit rib-compression techniques",
      "correction": "Position triangle lock at hip level or lower waist, maintaining firm but controlled pressure focused on restricting movement rather than causing pain compliance through skeletal compression"
    },
    {
      "error": "Neglecting upper body control while establishing triangle",
      "consequence": "Allows opponent to establish defensive posture, defend neck effectively, create hand fighting opportunities, and potentially escape despite leg control being present",
      "correction": "Maintain constant seatbelt or collar control throughout triangle establishment, keeping chest tight to back and never releasing upper body grips until triangle is fully locked and secure"
    },
    {
      "error": "Over-tightening triangle and creating rigidity",
      "consequence": "Reduces ability to adjust angles for submissions, limits hip mobility for choke setups, fatigues leg muscles unnecessarily, and can cause cramping during extended control",
      "correction": "Apply firm but dynamic triangle pressure that allows for subtle adjustments, tighten during submission attempts and relax slightly during transitions while maintaining lock integrity"
    },
    {
      "error": "Allowing opponent to turn into you without counter-adjustment",
      "consequence": "Creates escape opportunities, allows opponent to establish defensive frames, reduces choking angles, and can lead to loss of back control or transition to inferior positions",
      "correction": "When opponent turns in, immediately transition to crucifix control or mount position, using their momentum against them rather than fighting to maintain original body triangle configuration"
    },
    {
      "error": "Focusing solely on one submission without adapting to defenses",
      "consequence": "Opponent can specialize their defensive efforts, stall position indefinitely, and potentially survive to end of round without significant submission danger despite positional dominance",
      "correction": "Implement systematic attack chains (rear naked choke to armbar to triangle to bow and arrow), flowing between submissions based on defensive reactions and creating submission dilemmas"
    },
    {
      "error": "Releasing triangle prematurely when opponent shows initial resistance",
      "consequence": "Loses superior control position, allows opponent to recover hooks defense or escape entirely, wastes energy expended establishing triangle, and reduces psychological pressure on opponent",
      "correction": "Maintain triangle lock through initial escape attempts, understanding that position is sustainable long-term and opponent's defensive efforts will fatigue them while attacker remains efficient"
    }
  ],
