  "common_errors": [
    {
      "error": "Posting arms too wide and away from body",
      "consequence": "Creates space underneath allowing opponent to insert frames, reduces pressure on opponent, and makes it easier for opponent to execute hip escapes or recover guard",
      "correction": "Keep elbows tight to body, use narrow base with hands close to opponent's body, distribute weight through chest and shoulder rather than posting on extended arms"
    },
    {
      "error": "Weight positioned too high on opponent's chest or shoulders",
      "consequence": "Allows opponent to bridge effectively, reduces control over hips, makes position easier to escape, and limits submission options from the position",
      "correction": "Lower hips toward mat, settle weight into opponent's diaphragm and lower chest area, maintain pressure through shoulder driving into opponent's jaw while keeping own hips low"
    },
    {
      "error": "Hips positioned too high or too far from opponent",
      "consequence": "Creates space for opponent to insert knee and recover guard, reduces overall pressure and control, makes transitions to mount or other positions more difficult",
      "correction": "Keep hips close to opponent's body, settle weight down into opponent rather than staying elevated, maintain connection between your hip and opponent's hip line"
    },
    {
      "error": "Focusing only on upper body control while neglecting hip positioning",
      "consequence": "Opponent can use legs and hips to create space and movement even with upper body controlled, enables guard recovery, and allows opponent to escape more easily",
      "correction": "Maintain simultaneous control of both upper body (crossface/head control) and hips (blocking with own hip, controlling with near arm), prevent any leg insertion"
    },
    {
      "error": "Hunting for submissions too early without establishing solid control first",
      "consequence": "Loses position control while chasing submission, creates opportunities for opponent to escape or reverse position, reduces overall effectiveness and position retention",
      "correction": "Establish dominant control first with multiple control points, break down opponent's defensive structure systematically, only pursue submissions when position is completely secure"
    },
    {
      "error": "Remaining static in one side control variation without transitioning",
      "consequence": "Allows opponent to develop specific defensive responses, reduces offensive pressure, makes position more predictable and easier to defend or escape",
      "correction": "Flow between side control variations (standard, reverse kesa, knee on belly, north-south) in response to opponent's defensive movements, maintain constant pressure while staying mobile"
    }
  ],
  "training_drills": [
    {
      "name": "Side Control Maintenance Against Progressive Resistance",
      "description": "Start in side control with compliant partner. Partner gradually increases escape attempts over 3-minute rounds. Focus on maintaining position through weight distribution, pressure application, and transitioning between side control variations. Progress from 25% resistance to 75% resistance over multiple rounds.",
      "duration": "3-5 minutes per round"
    },
    {
      "name": "Side Control Variation Flow Drill",
      "description": "Practice flowing between side control variations (standard side control, knee on belly, north-south, kesa gatame, reverse kesa gatame) in response to training partner's movements. Partner provides directional resistance by moving in specific patterns. Focus on maintaining constant pressure and control throughout transitions.",
      "duration": "5 minutes continuous"
    },
    {
      "name": "Submission Chain Sequences from Side Control",
      "description": "Start in side control and drill submission chains based on opponent's defensive reactions. Practice Americana to Kimura to armbar chains, arm triangle setups, and darce choke entries. Partner provides realistic defensive responses. Focus on maintaining position control while pursuing submissions.",
      "duration": "3-4 minutes per sequence"
    },
    {
      "name": "Side Control Escape Prevention Drill",
