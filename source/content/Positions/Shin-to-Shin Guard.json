  "common_errors": [
    {
      "error": "Insufficient shin pressure and passive leg connection",
      "consequence": "Opponent easily clears the shin or steps over without resistance, nullifying the guard's effectiveness and allowing easy passing opportunities",
      "correction": "Actively drive shin across opponent's shin with constant pressure, adjusting angle to maintain connection while using hips to create upward and lateral force against their base"
    },
    {
      "error": "Poor upper body posture with rounded back and collapsed torso",
      "consequence": "Loss of balance and structural integrity makes it impossible to generate sweeping force, and creates vulnerability to being driven backward and passed",
      "correction": "Maintain upright seated posture with straight spine, active core engagement, and shoulders pulled back to create stable platform for sweeps and transitions"
    },
    {
      "error": "Incorrect angle of shin placement, placing it too high or too low on opponent's leg",
      "consequence": "Weak connection that provides insufficient leverage for sweeps and allows opponent to easily clear or step over the shin",
      "correction": "Position shin across the lower third of opponent's tibia at approximately 45-degree angle, creating maximum leverage and making it difficult to clear"
    },
    {
      "error": "Neglecting upper body grips and relying solely on leg connection",
      "consequence": "Opponent controls your upper body, breaks your posture, and can drive forward with pressure to pass despite shin connection",
      "correction": "Establish and maintain strategic grips (sleeve, collar, pants) to manage distance and prevent opponent from achieving dominant upper body control"
    },
    {
      "error": "Static positioning without dynamic adjustment of angles and pressure",
      "consequence": "Predictable guard becomes easy to pass as opponent learns timing and can methodically work around static connection points",
      "correction": "Constantly adjust hip position, shin angle, and pressure in response to opponent's movements, creating dynamic puzzle that forces reactions and opens sweep opportunities"
    },
    {
      "error": "Overcommitting to shin connection without transitioning when opponent defends",
      "consequence": "Wasted energy fighting for position that opponent has neutralized, allowing them to consolidate passing position while you remain stuck",
      "correction": "Recognize when shin-to-shin is being neutralized and smoothly transition to related guards (single leg X, X-guard, DLR) before opponent establishes passing control"
    },
    {
      "error": "Allowing opponent to control your free leg and establish grips",
      "consequence": "Opponent uses your free leg to break structure and pass, or establishes leg drag position for easy passing sequences",
      "correction": "Keep free leg mobile and away from opponent's grips, using it to frame, post, or establish secondary connections rather than leaving it vulnerable"
    }
  ],
