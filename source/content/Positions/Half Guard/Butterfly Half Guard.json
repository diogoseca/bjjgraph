  "common_errors": [
    {
      "error": "Passive butterfly hook without active upward pressure",
      "consequence": "Leads to ineffective elevation, limiting your ability to off-balance or sweep the opponent using the butterfly side, allowing them to settle their weight and establish passing pressure",
      "correction": "Keep the butterfly hook active by driving your foot under the opponent's thigh to create constant upward pressure, engaging your hip flexors and maintaining tension in the hook even when not actively sweeping"
    },
    {
      "error": "Lying flat on back instead of maintaining seated posture",
      "consequence": "Results in reduced sweeping leverage, making it easier for the opponent to apply pressure and pass your guard, eliminating the mechanical advantage of the butterfly hook",
      "correction": "Maintain an upright or semi-reclined posture with shoulders off the mat, using your core strength to stay engaged and keep your hips mobile for sweeping opportunities"
    },
    {
      "error": "Losing upper body connection and allowing opponent to establish dominant grips",
      "consequence": "Permits opponent to control your posture, flatten you out, and initiate passing sequences without resistance from your upper body control",
      "correction": "Fight for underhook on the butterfly side or establish strong collar ties, never allowing opponent to have uncontested upper body control, constantly hand fighting to maintain advantageous grips"
    },
    {
      "error": "Allowing opponent to free their trapped leg without consequence",
      "consequence": "Transforms position into pure butterfly guard where you lose the stability advantage and defensive security that half guard provides",
      "correction": "Maintain constant squeeze pressure on the trapped leg while using the threat of sweeps to keep opponent engaged in defending rather than escaping the half guard trap"
    },
    {
      "error": "Failing to adjust hip angle and maintain optimal positioning for sweeps",
      "consequence": "Creates situations where sweeps lack proper leverage and become low percentage, wasting energy on ineffective attempts",
      "correction": "Constantly adjust your hip position to create angles perpendicular to opponent's base, using small hip movements to optimize sweep mechanics before committing to the technique"
    },
    {
      "error": "Neglecting to transition when opponent establishes strong defensive position",
      "consequence": "Results in stalled position where neither player can advance, burning energy without productive outcomes",
      "correction": "Flow between butterfly half guard and related positions like deep half or lockdown when opponent successfully defends, maintaining offensive initiative through position changes"
    }
  ],
