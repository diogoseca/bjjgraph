  "common_errors": [
    {
      "error": "Telegraphing submission intention by gripping collar too aggressively or obviously",
      "consequence": "Opponent immediately recognizes threat and establishes strong neck defense before choke can be applied",
      "correction": "Establish collar grip gradually and casually while opponent is focused on defending hooks or other threats, making the grip appear positional rather than attacking"
    },
    {
      "error": "Failing to maintain proper seatbelt structure while focusing on collar grip",
      "consequence": "Opponent escapes back control by swimming arms through or removing hooks while practitioner is distracted",
      "correction": "Keep non-collar arm active in seatbelt position with elbow tight to body, maintaining back control structure even while establishing invisible collar grip"
    },
    {
      "error": "Insufficient collar grip depth with fingers not deep enough inside gi material",
      "consequence": "Choke lacks finishing pressure and opponent can easily defend or remove the grip with hand fighting",
      "correction": "Drive all four fingers as deep as possible into collar with knuckles against opponent's neck, using gradual incremental adjustments to achieve maximum depth"
    },
    {
      "error": "Losing hook control while attempting to finish the choke",
      "consequence": "Opponent escapes to guard or scrambles to better position while practitioner is focused solely on submission",
      "correction": "Coordinate lower body and upper body attacks simultaneously, ensuring hooks remain active and controlling throughout the finishing sequence"
    },
    {
      "error": "Applying choking pressure too early before grip is fully established",
      "consequence": "Opponent becomes aware of submission threat prematurely and effectively defends before the position is secured",
      "correction": "Wait until invisible collar grip is completely set with proper depth and hand position before beginning to apply finishing pressure"
    },
    {
      "error": "Failing to adjust when opponent successfully defends the collar choke",
      "consequence": "Practitioner becomes fixated on one submission while opponent creates space and eventually escapes",
      "correction": "Maintain fluid transitions between collar chokes, rear naked chokes, and armbars, using opponent's defensive movements to set up alternative attacks"
    },
    {
      "error": "Poor body positioning with weight too far back or not centered on opponent",
      "consequence": "Opponent can roll practitioner over their shoulder or turn into the position to escape",
      "correction": "Keep chest tight to opponent's upper back with weight distributed evenly, adjusting position dynamically as opponent moves"
    }
