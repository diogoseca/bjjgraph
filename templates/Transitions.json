{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BJJ Transition Template Schema V3",
  "description": "Standardized JSON schema for BJJ transition pages - strict 14-section structure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "summary",
    "description",
    "tags",
    "from_position",
    "outcomes",
    "success_rate",
    "overview",
    "key_principles",
    "setup_requirements",
    "execution_steps",
    "common_counters",
    "common_errors",
    "training_progressions",
    "variants_and_adaptations",
    "flashcards",
    "safety_considerations",
    "position_integration",
    "related_content"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Technique name (must match filename without .json)",
      "minLength": 3,
      "examples": [
        "Hip Bump Sweep",
        "Arm Drag to Back Take"
      ]
    },
    "description": {
      "type": "string",
      "description": "SEO meta description 150-160 characters",
      "minLength": 140,
      "maxLength": 180,
      "examples": [
        "Learn Hip Bump Sweep in BJJ. Step-by-step execution from Closed Guard to Mount. Success rates: Beginner 40%, Intermediate 55%, Advanced 70%."
      ]
    },
    "tags": {
      "type": "array",
      "description": "Content tags (minimum 3)",
      "minItems": 3,
      "items": {
        "type": "string"
      },
      "examples": [
        [
          "bjj",
          "technique",
          "sweep",
          "guard"
        ]
      ]
    },
    "from_position": {
      "type": "string",
      "description": "Position/Role where technique begins (format: Position/Role, e.g., 'Closed Guard/Bottom')",
      "examples": [
        "Closed Guard/Bottom",
        "Half Guard/Bottom",
        "Mount/Top"
      ]
    },
    "outcomes": {
      "type": "array",
      "description": "Possible outcomes of this transition. probability MUST sum to 100%",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "to",
          "probability",
          "result"
        ],
        "properties": {
          "to": {
            "type": "string",
            "description": "Target position/role"
          },
          "probability": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "result": {
            "type": "string",
            "enum": [
              "success",
              "failure",
              "counter"
            ]
          }
        }
      }
    },
    "success_rate": {
      "type": "integer",
      "description": "Overall success rate percentage (0-100)",
      "minimum": 0,
      "maximum": 100
    },
    "summary": {
      "type": "string",
      "minLength": 30,
      "maxLength": 300,
      "description": "One-sentence, self-contained definition that leads the page (answer-first for AI / featured snippets). ~15-40 words. If present, the overview must NOT repeat it."
    },
    "overview": {
      "type": "string",
      "description": "2-3 paragraph technique description with strategic context (400+ characters). LEAD with a self-contained one-sentence definition that directly answers 'what is X' before history/context — AI answer engines quote the first sentence; if a summary field is present, start the overview with context instead.",
      "minLength": 400,
      "examples": [
        "The Hip Bump Sweep is a fundamental attack from closed guard that exploits opponent's posture..."
      ]
    },
    "key_principles": {
      "type": "array",
      "description": "5-7 fundamental principles",
      "minItems": 5,
      "maxItems": 7,
      "items": {
        "type": "string"
      },
      "examples": [
        [
          "Break opponent's posture before initiating sweep",
          "Create angle with hip movement",
          "Use opponent's reaction to your advantage"
        ]
      ]
    },
    "setup_requirements": {
      "type": "array",
      "description": "Prerequisites before executing (minimum 4)",
      "minItems": 4,
      "items": {
        "type": "string"
      },
      "examples": [
        [
          "Closed guard established with ankles crossed",
          "Opponent's posture broken forward",
          "Strong grip on opponent's sleeve or wrist"
        ]
      ]
    },
    "execution_steps": {
      "type": "array",
      "description": "Step-by-step execution sequence (minimum 6)",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_number",
          "action",
          "description"
        ],
        "properties": {
          "step_number": {
            "type": "integer",
            "minimum": 1
          },
          "action": {
            "type": "string",
            "description": "Brief action name (e.g., 'Break posture')"
          },
          "description": {
            "type": "string",
            "description": "Detailed execution with anatomical detail (50+ characters)",
            "minLength": 50
          }
        }
      }
    },
    "common_counters": {
      "type": "array",
      "description": "Opponent's defensive responses (minimum 3)",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "counter",
          "effectiveness"
        ],
        "properties": {
          "counter": {
            "type": "string",
            "description": "Counter technique description"
          },
          "effectiveness": {
            "type": "string",
            "enum": [
              "High",
              "Medium",
              "Low"
            ]
          },
          "your_response": {
            "type": "string",
            "description": "How to counter their counter"
          }
        }
      }
    },
    "common_errors": {
      "type": "array",
      "description": "Common mistakes with corrections (minimum 5)",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "consequence",
          "correction"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "consequence": {
            "type": "string"
          },
          "correction": {
            "type": "string"
          }
        }
      }
    },
    "training_progressions": {
      "type": "array",
      "description": "Progressive training phases (minimum 4)",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "focus",
          "description"
        ],
        "properties": {
          "phase": {
            "type": "string",
            "description": "Training phase (e.g., 'Week 1-2', 'Beginner Phase')"
          },
          "focus": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "variants_and_adaptations": {
      "type": "array",
      "description": "Technique variations (minimum 2)",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "variant_name",
          "description"
        ],
        "properties": {
          "variant_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "when_to_use": {
            "type": "string"
          }
        }
      }
    },
    "flashcards": {
      "type": "array",
      "description": "Understanding test questions (minimum 5, feeds FAQ schema)",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "answer"
        ],
        "properties": {
          "question": {
            "type": "string",
            "pattern": ".*\\?$",
            "description": "Must end with question mark"
          },
          "answer": {
            "type": "string",
            "minLength": 50
          }
        }
      }
    },
    "safety_considerations": {
      "type": "string",
      "description": "Safety notes and precautions (100+ characters)",
      "minLength": 100,
      "examples": [
        "When practicing this sweep, ensure controlled execution to avoid injury..."
      ]
    },
    "position_integration": {
      "type": "string",
      "description": "How technique fits in BJJ system (200+ characters)",
      "minLength": 200,
      "examples": [
        "The Hip Bump Sweep is part of the fundamental closed guard attack system..."
      ]
    },
    "related_content": {
      "type": "array",
      "description": "Related techniques/positions (3-15 items)",
      "minItems": 3,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "relationship"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "relationship": {
            "type": "string",
            "description": "How it relates (e.g., 'Follow-up', 'Alternative', 'Counter')"
          }
        }
      }
    }
  }
}
