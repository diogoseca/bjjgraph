{# BJJ Submission Attacker Page Template #}
{# Generates attacker perspective pages from attacker section #}
{# Input: attacker (full attacker section), name (hub name), from_position, outcomes, safety_considerations, target_area #}

---
title: "{{ name }} Attacker | BJJ Submission Guide | BJJ Graph"
description: "{{ attacker.description }}"
---

{# PostHog A/B Testing Metadata #}
<body data-content-type="submissions">

> **SAFETY**: {{ name }} targets the {{ target_area }}. Risk: {{ safety_considerations.injury_risks[0].injury }}. Release immediately upon tap.

<!-- Schema Markup - HowTo for Execution -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": {{ ("How to Execute " ~ (name) ~ " in BJJ") | jsonstr }},
  "description": {{ ("Step-by-step guide for " ~ (name) ~ " with safety protocols.") | jsonstr }},
  "step": [
    {%- for step in attacker.execution_steps[:8] %}
    {
      "@type": "HowToStep",
      "name": {{ step.action | jsonstr }},
      "text": {{ step.description | jsonstr }},
      "position": {{ loop.index }}
    }{{ "," if not loop.last else "" }}
    {%- endfor %}
  ],
  "tool": ["BJJ Gi or No-Gi attire", "Training partner", "Mat space"],
  "totalTime": "PT5M"
}
</script>

<!-- Schema Markup - FAQ from Knowledge Assessment -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for qa in attacker.flashcards[:6] %}
    {
      "@type": "Question",
      "name": {{ qa.question | jsonstr }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ qa.answer | jsonstr }}
      }
    }{{ "," if not loop.last else "" }}
    {%- endfor %}
  ]
}
</script>

<!-- Schema Markup - WebPage -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": {{ ((name) ~ " Attacker") | jsonstr }},
  "description": {{ attacker.description | jsonstr }},
  {%- if aliases is defined and aliases %}
  "alternateName": [{% for alias in aliases %}{{ alias | tojson }}{{ ", " if not loop.last else "" }}{% endfor %}],
  {%- endif %}
  {%- if disambiguations is defined and disambiguations %}
  {%- set _ns = namespace(dd='') %}
  {%- for d in disambiguations %}{% set _ns.dd = _ns.dd + 'Often confused with ' + d.name + ' — ' + d.reason + '.' + (' ' if not loop.last else '') %}{% endfor %}
  "disambiguatingDescription": {{ _ns.dd | tojson }},
  {%- endif %}
  {%- if sameAs is defined and sameAs %}
  "sameAs": [{% for u in sameAs %}{{ u | tojson }}{{ ", " if not loop.last else "" }}{% endfor %}],
  {%- endif %}
  "isPartOf": {
    "@type": "WebSite",
    "name": "BJJ Graph",
    "url": "https://bjjgraph.org"
  }{%- if family is defined and family %},
  "mainEntityOfPage": {
    "@type": "CollectionPage",
    "name": {{ family | jsonstr }},
    "url": {{ ("https://bjjgraph.org/Families/" ~ (family | slugify)) | jsonstr }}
  }
  {%- endif %}
}
</script>

<!-- Schema Markup - Breadcrumbs -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://bjjgraph.org/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Submissions",
      "item": "https://bjjgraph.org/Submissions/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {{ name | jsonstr }},
      "item": {{ ("https://bjjgraph.org/Submissions/" ~ (name.replace(' ', '-'))) | jsonstr }}
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": "Attacker",
      "item": {{ ("https://bjjgraph.org/Submissions/" ~ (name.replace(' ', '-')) ~ "/Attacker") | jsonstr }}
    }
  ]
}
</script>

{# --- Film study clips: curated by scripts/source_clips.py, never AI-authored --- #}
{%- set film_clips = attacker.clips if attacker.clips is defined and attacker.clips else [] %}
{%- set film_context = name ~ " (Attacker)" %}

{% if film_clips %}
<!-- Schema Markup - VideoObject (curated film-study clips) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": {{ (film_context ~ " — Film Study") | tojson }},
  "itemListElement": [
    {%- for clip in film_clips %}
    {
      "@type": "VideoObject",
      "position": {{ loop.index }},
      "name": {{ clip.title | tojson }},
      "description": {{ (film_context ~ " film study: " ~ clip.title ~ ((", taught by " ~ clip.by) if clip.by else "") ~ ".") | tojson }},
      "thumbnailUrl": {{ ("https://i.ytimg.com/vi/" ~ clip.id ~ "/hqdefault.jpg") | tojson }},
      "embedUrl": {{ ("https://www.youtube.com/embed/" ~ clip.id ~ (("?start=" ~ (clip.start | string)) if clip.start else "")) | tojson }},
      "url": {{ ("https://www.youtube.com/watch?v=" ~ clip.id) | tojson }}
      {%- if clip.by %},
      "creator": { "@type": "Person", "name": {{ clip.by | tojson }} }
      {%- endif %}
      {%- if clip.duration %},
      "duration": {{ ("PT" ~ (clip.duration) ~ "S") | jsonstr }}
      {%- endif %}
      {%- if clip.upload_date %},
      "uploadDate": {{ clip.upload_date | tojson }}
      {%- endif %}
    }{{ "," if not loop.last else "" }}
    {%- endfor %}
  ]
}
</script>
{% endif %}

{# Flexbox wrapper for A/B testing #}
<main class="content-wrapper" style="display: flex; flex-direction: column;">

{% if (aliases is defined and aliases) or (family is defined and family) or (disambiguations is defined and disambiguations) -%}
<aside class="entity-relations">
{%- if aliases is defined and aliases %}
<p class="also-known-as"><em>Also known as:</em> {% for alias in aliases %}<strong>{{ alias | e }}</strong>{{ ", " if not loop.last else "" }}{% endfor %} <span class="role-hint">(attacker)</span></p>
{%- endif %}
{%- if family is defined and family %}
<p class="part-of-family"><em>Part of the</em> <strong>{% if resolve.family_exists(family) %}[[Families/{{ family }}|{{ family | e }}]]{% else %}{{ family | e }}{% endif %}</strong> <em>family</em></p>
{%- endif %}
{%- if disambiguations is defined and disambiguations %}
{%- for d in disambiguations %}
<p class="often-confused-with"><em>Often confused with</em> <strong>{% if resolve.page_exists(d.name) %}[[{{ resolve(d.name) }}|{{ d.name | e }}]]{% else %}{{ d.name | e }}{% endif %}</strong> — {{ d.reason | e }}</p>
{%- endfor %}
{%- endif %}
</aside>
{% endif -%}

<section id="overview" class="content-section">

{{ attacker.overview }}

{% if from_position is defined and from_position -%}
**From Position**: [[{{ resolve(from_position.split('/')[0]) }}]] ({{ from_position.split('/')[1] if '/' in from_position else '' }})
{% endif %}

</section>

{% if film_clips %}
<section id="film-study" class="content-section">

## Film Study

<p class="section-subtitle">Watch {{ film_context }} in action — curated instructionals</p>

{% for clip in film_clips %}
<div class="film-clip{{ ' film-clip--vertical' if clip.vertical else '' }}">

![](https://www.youtube.com/watch?v={{ clip.id }}{% if clip.start %}&start={{ clip.start }}{% endif %}{% if clip.end %}&end={{ clip.end }}{% endif %})

<p class="clip-credit"><strong>{{ clip.title | e }}</strong>{% if clip.by %} — taught by {{ clip.by | e }}{% endif %}{% if clip.duration %} · {{ "%d:%02d" | format(clip.duration // 60, clip.duration % 60) }}{% endif %} · <a href="https://www.youtube.com/watch?v={{ clip.id }}{% if clip.start %}&t={{ clip.start }}s{% endif %}" rel="noopener">Watch on YouTube{% if clip.start %} from {{ "%d:%02d" | format(clip.start // 60, clip.start % 60) }}{% endif %}</a></p>

</div>
{% endfor %}

</section>
{% endif %}

<section id="key-principles" class="content-section">

## Key Attacking Principles

<p class="section-subtitle">What are the key principles for executing {{ name }}?</p>

{% for principle in attacker.key_principles -%}
- {{ principle }}
{% endfor %}

</section>

<section id="setup-requirements" class="content-section">

## Prerequisites

<p class="section-subtitle">What do you need before attempting {{ name }}?</p>

{% for req in attacker.setup_requirements -%}
- {{ req }}
{% endfor %}

</section>

<section id="execution-steps" class="content-section">

## Execution Steps

<p class="section-subtitle">How do you execute {{ name }} step by step?</p>

{% for step in attacker.execution_steps -%}
{{ step.step_number }}. **{{ step.action }}**: {{ step.description }}{% if step.timing %} (Timing: {{ step.timing }}){% endif %}
{% endfor %}

</section>

<section id="possible-outcomes" class="content-section">

## Possible Outcomes

| Result | Position | Probability |
|--------|----------|-------------|
{% for outcome in outcomes -%}
| {{ outcome.result | capitalize }} | [[{{ resolve(outcome.to.split('/')[0] if '/' in outcome.to else outcome.to) }}]] | {{ outcome.probability }}% |
{% endfor %}

</section>

<section id="common-counters" class="content-section">

## Opponent Defenses

<p class="section-subtitle">How might your opponent defend against {{ name }}?</p>

{% for counter in attacker.common_counters -%}
- **{{ counter.counter }}** (Effectiveness: {{ counter.effectiveness }}){% if counter.your_response %} - Your Response: {{ counter.your_response }}{% endif %}{% if counter.targets_outcome %} → Leads to [[{{ resolve(counter.targets_outcome.split('/')[0] if '/' in counter.targets_outcome else counter.targets_outcome) }}]]{% endif %}
{% endfor %}

</section>

<section id="common-mistakes" class="content-section hide-minimal">

## Common Attacking Mistakes

<p class="section-subtitle">What mistakes should you avoid when executing {{ name }}?</p>

{% for error in attacker.common_errors -%}
### {{ loop.index }}. {{ error.error }}

- **Consequence**: {{ error.consequence }}
- **Correction**: {{ error.correction }}

{% endfor %}

</section>

<section id="training-progressions" class="content-section hide-minimal">

## Training Progressions

<p class="section-subtitle">How do you train {{ name }} (Attacker)?</p>

{% for progression in attacker.training_progressions -%}
**{{ progression.phase }}** - {{ progression.focus }}
{{ progression.description }}

{% endfor %}

</section>

{# Knowledge assessment rendered as interactive flashcards by TransitionFlashcard component #}

</main>
