{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BJJ Learning Article Schema V2",
  "description": "Concise, practical BJJ reading with complete content available in the app and static page",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "summary",
    "tags",
    "category",
    "overview",
    "key_takeaways",
    "bjj_applications",
    "common_mistakes",
    "training_exercises",
    "related_content"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Article name (must match filename without .json)",
      "minLength": 3,
      "examples": [
        "Technique Chaining",
        "Training Partner Diversity"
      ]
    },
    "display_title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 90,
      "description": "Optional reader-facing title. Keep name, filename and URL unchanged."
    },
    "description": {
      "type": "string",
      "description": "SEO meta description 140-180 characters",
      "minLength": 140,
      "maxLength": 180,
      "examples": [
        "Connect BJJ attacks by noticing the response to the first technique. Practice useful follow-ups, recognize when to reset, and avoid forcing a preset sequence."
      ]
    },
    "tags": {
      "type": "array",
      "description": "Content tags (minimum 3)",
      "minItems": 3,
      "items": {
        "type": "string"
      },
      "examples": [
        [
          "bjj",
          "learning",
          "strategy",
          "technique-chaining"
        ]
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "Strategy",
        "Training",
        "Competition"
      ],
      "description": "Article category"
    },
    "summary": {
      "type": "string",
      "minLength": 30,
      "maxLength": 260,
      "description": "One useful sentence that states the article's practical point. The overview adds context instead of repeating it."
    },
    "overview": {
      "type": "string",
      "description": "One or two practical sentences: when this matters, what to notice, or a useful limitation. Do not repeat the summary or pad a definition.",
      "minLength": 30,
      "maxLength": 450
    },
    "key_takeaways": {
      "type": "array",
      "description": "3-5 distinct, practical takeaways",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 10,
        "maxLength": 300
      }
    },
    "bjj_applications": {
      "type": "array",
      "description": "2-4 recognizable mat situations, actions, and outcomes to look for; avoid guarantees",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario",
          "application",
          "outcome"
        ],
        "properties": {
          "scenario": {
            "type": "string",
            "description": "Specific BJJ situation",
            "minLength": 3,
            "maxLength": 160
          },
          "application": {
            "type": "string",
            "description": "How the concept applies",
            "minLength": 10,
            "maxLength": 600
          },
          "outcome": {
            "type": "string",
            "description": "An observable result or useful limitation, not a promise",
            "minLength": 10,
            "maxLength": 400
          }
        }
      }
    },
    "common_mistakes": {
      "type": "array",
      "description": "1-3 concrete mistakes with consequences and corrections",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mistake",
          "consequence",
          "correction"
        ],
        "properties": {
          "mistake": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "consequence": {
            "type": "string",
            "minLength": 10,
            "maxLength": 400
          },
          "correction": {
            "type": "string",
            "minLength": 10,
            "maxLength": 450
          }
        }
      }
    },
    "training_exercises": {
      "type": "array",
      "description": "1-2 useful exercises with setup, action, and reset or stop conditions",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description",
          "focus"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "minLength": 50,
            "maxLength": 900
          },
          "focus": {
            "type": "string",
            "minLength": 3,
            "maxLength": 260
          }
        }
      }
    },
    "knowledge_assessment": {
      "type": "array",
      "description": "Optional self-assessment: at most four useful questions with explanations; not a scored deck",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "answer"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 10,
            "maxLength": 240
          },
          "answer": {
            "type": "string",
            "minLength": 10,
            "maxLength": 700
          },
          "distractors": {
            "type": "object",
            "additionalProperties": false,
            "description": "Legacy optional quiz metadata retained for source compatibility. Learning self-assessment is unscored and shows question/answer only.",
            "properties": {
              "plausible": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 200
                }
              },
              "trap": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 200
                }
              }
            }
          },
          "answer_line": {
            "type": "string",
            "maxLength": 60,
            "description": "Legacy optional recall cue retained for source compatibility; the reader shows the full answer."
          }
        }
      }
    },
    "related_content": {
      "type": "array",
      "description": "Related positions/transitions/principles/learning (3-15 items)",
      "minItems": 3,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "content_type",
          "relationship"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "content_type": {
            "type": "string",
            "enum": [
              "Position",
              "Transition",
              "Submission",
              "Principle",
              "System",
              "Learning"
            ]
          },
          "relationship": {
            "type": "string"
          }
        }
      }
    },
    "references": {
      "type": "array",
      "description": "Optional relevant primary sources actually inspected; do not fill a citation quota",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "author"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 240
          },
          "author": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "url": {
            "type": "string",
            "maxLength": 1000,
            "pattern": "^https?://"
          }
        }
      }
    }
  }
}
