{# BJJ Position Top (Attacks) Page Template #}
{# Generates offensive perspective pages from top section #}
{# Input: top (full top section from JSON) #}

---
title: "{{ top.name }} | BJJ Position Guide | BJJ Graph"
description: "{{ top.description }}"
---

{# PostHog A/B Testing Metadata #}
<body data-content-type="positions">

<!-- Schema Markup - HowTo for Attacks -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": {{ ("How to Attack from " ~ (top.name)) | jsonstr }},
  "description": {{ ("Step-by-step guide to attacking and submitting from " ~ (top.name.replace(' Top', '').replace(' (Attacks)', '')) ~ " position in BJJ.") | jsonstr }},
  "step": [
    {%- for transition in top.transitions[:6] %}
    {
      "@type": "HowToStep",
      "name": {{ ("Execute " ~ (transition.transition)) | jsonstr }},
      "text": {{ ("From this position, attempt " ~ (transition.transition) ~ ". This technique is attempted in " ~ (transition.attempt_probability) ~ "% of exchanges from this position.") | jsonstr }},
      "position": {{ loop.index }}
    }{{ "," if not loop.last else "" }}
    {%- endfor %}
  ],
  "totalTime": "PT2M"
}
</script>

<!-- Schema Markup - FAQ from Common Mistakes -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for error in top.common_errors[:5] %}
    {
      "@type": "Question",
      "name": {{ ("What happens if you " ~ (error.error.lower()) ~ "?") | jsonstr }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ ((error.consequence) ~ " The correct approach is: " ~ (error.correction)) | jsonstr }}
      }
    }{{ "," if not loop.last else "" }}
    {%- endfor %}
  ]
}
</script>

<!-- Schema Markup - WebPage -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": {{ top.name | jsonstr }},
  "description": {{ top.description | jsonstr }},
  {%- if aliases is defined and aliases %}
  "alternateName": [{% for alias in aliases %}{{ alias | tojson }}{{ ", " if not loop.last else "" }}{% endfor %}],
  {%- endif %}
  {%- if disambiguations is defined and disambiguations %}
  {%- set _ns = namespace(dd='') %}
  {%- for d in disambiguations %}{% set _ns.dd = _ns.dd + 'Often confused with ' + d.name + ' — ' + d.reason + '.' + (' ' if not loop.last else '') %}{% endfor %}
  "disambiguatingDescription": {{ _ns.dd | tojson }},
  {%- endif %}
  {%- if sameAs is defined and sameAs %}
  "sameAs": [{% for u in sameAs %}{{ u | tojson }}{{ ", " if not loop.last else "" }}{% endfor %}],
  {%- endif %}
  "isPartOf": {
    "@type": "WebSite",
    "name": "BJJ Graph",
    "url": "https://bjjgraph.org"
  }{%- if family is defined and family %},
  "mainEntityOfPage": {
    "@type": "CollectionPage",
    "name": {{ family | jsonstr }},
    "url": {{ ("https://bjjgraph.org/Families/" ~ (family | slugify)) | jsonstr }}
  }
  {%- endif %}
}
</script>

<!-- Schema Markup - Breadcrumbs -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://bjjgraph.org/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Positions",
      "item": "https://bjjgraph.org/Positions/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {{ top.name | jsonstr }},
      "item": {{ ("https://bjjgraph.org/Positions/" ~ (top.name.replace(' ', '-'))) | jsonstr }}
    }
  ]
}
</script>

{# --- Film study clips: curated by scripts/source_clips.py, never AI-authored --- #}
{%- set film_clips = top.clips if top.clips is defined and top.clips else [] %}
{%- set film_context = position_name ~ " (Top)" %}

{% if film_clips %}
<!-- Schema Markup - VideoObject (curated film-study clips) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": {{ (film_context ~ " — Film Study") | tojson }},
  "itemListElement": [
    {%- for clip in film_clips %}
    {
      "@type": "VideoObject",
      "position": {{ loop.index }},
      "name": {{ clip.title | tojson }},
      "description": {{ (film_context ~ " film study: " ~ clip.title ~ ((", taught by " ~ clip.by) if clip.by else "") ~ ".") | tojson }},
      "thumbnailUrl": {{ ("https://i.ytimg.com/vi/" ~ clip.id ~ "/hqdefault.jpg") | tojson }},
      "embedUrl": {{ ("https://www.youtube.com/embed/" ~ clip.id ~ (("?start=" ~ (clip.start | string)) if clip.start else "")) | tojson }},
      "url": {{ ("https://www.youtube.com/watch?v=" ~ clip.id) | tojson }}
      {%- if clip.by %},
      "creator": { "@type": "Person", "name": {{ clip.by | tojson }} }
      {%- endif %}
      {%- if clip.duration %},
      "duration": {{ ("PT" ~ (clip.duration) ~ "S") | jsonstr }}
      {%- endif %}
      {%- if clip.upload_date %},
      "uploadDate": {{ clip.upload_date | tojson }}
      {%- endif %}
    }{{ "," if not loop.last else "" }}
    {%- endfor %}
  ]
}
</script>
{% endif %}

{# Flexbox wrapper for A/B testing #}
<main class="content-wrapper" style="display: flex; flex-direction: column;">

{% if (aliases is defined and aliases) or (family is defined and family) or (disambiguations is defined and disambiguations) -%}
<aside class="entity-relations">
{%- if aliases is defined and aliases %}
<p class="also-known-as"><em>Also known as:</em> {% for alias in aliases %}<strong>{{ alias | e }}</strong>{{ ", " if not loop.last else "" }}{% endfor %} <span class="role-hint">(top)</span></p>
{%- endif %}
{%- if family is defined and family %}
<p class="part-of-family"><em>Part of the</em> <strong>{% if resolve.family_exists(family) %}[[Families/{{ family }}|{{ family | e }}]]{% else %}{{ family | e }}{% endif %}</strong> <em>family</em></p>
{%- endif %}
{%- if disambiguations is defined and disambiguations %}
{%- for d in disambiguations %}
<p class="often-confused-with"><em>Often confused with</em> <strong>{% if resolve.page_exists(d.name) %}[[{{ resolve(d.name) }}|{{ d.name | e }}]]{% else %}{{ d.name | e }}{% endif %}</strong> — {{ d.reason | e }}</p>
{%- endfor %}
{%- endif %}
</aside>
{% endif -%}

<section id="overview" class="content-section">

{{ top.overview }}

</section>

{% if film_clips %}
<section id="film-study" class="content-section">

## Film Study

<p class="section-subtitle">Watch {{ film_context }} in action — curated instructionals</p>

{% for clip in film_clips %}
<div class="film-clip{{ ' film-clip--vertical' if clip.vertical else '' }}">

![](https://www.youtube.com/watch?v={{ clip.id }}{% if clip.start %}&start={{ clip.start }}{% endif %}{% if clip.end %}&end={{ clip.end }}{% endif %})

<p class="clip-credit"><strong>{{ clip.title | e }}</strong>{% if clip.by %} — taught by {{ clip.by | e }}{% endif %}{% if clip.duration %} · {{ "%d:%02d" | format(clip.duration // 60, clip.duration % 60) }}{% endif %} · <a href="https://www.youtube.com/watch?v={{ clip.id }}{% if clip.start %}&t={{ clip.start }}s{% endif %}" rel="noopener">Watch on YouTube{% if clip.start %} from {{ "%d:%02d" | format(clip.start // 60, clip.start % 60) }}{% endif %}</a></p>

</div>
{% endfor %}

</section>
{% endif %}

<section id="state-invariants" class="content-section">

## Position Definition

<p class="section-subtitle">What is {{ position_name }} (Top)?</p>

{% for invariant in top.state_invariants -%}
- {{ invariant }}
{% endfor %}

</section>

<section id="prerequisites" class="content-section">

## Prerequisites

<p class="section-subtitle">What do you need before playing {{ position_name }} (Top)?</p>

{% for prereq in top.prerequisites -%}
- {{ prereq }}
{% endfor %}

</section>

<section id="key-principles" class="content-section">

## Key Offensive Principles

<p class="section-subtitle">What are the key principles for attacking from {{ position_name }}?</p>

{% for principle in top.key_principles -%}
- {{ principle }}
{% endfor %}

</section>

<section id="decision-tree" class="content-section">

## Decision Making from This Position

<p class="section-subtitle">What should you do from {{ position_name }} (Top)?</p>

{% for node in top.decision_tree -%}
**{{ node.condition }}:**
{% for action in node.actions -%}
- Execute **[[{{ resolve(action.technique) }}/Attacker|{{ action.technique }}]]** → [[{{ resolve(action.target) }}]] (Probability: {{ action.probability }}%)
{% endfor %}

{% endfor %}

</section>

<section id="common-mistakes" class="content-section hide-minimal">

## Common Offensive Mistakes

<p class="section-subtitle">What mistakes should you avoid when attacking from {{ position_name }}?</p>

{% for error in top.common_errors -%}
### {{ loop.index }}. {{ error.error }}

- ❌ **Consequence**: {{ error.consequence }}
- ✅ **Correction**: {{ error.correction }}

{% endfor %}

</section>

<section id="training-drills" class="content-section hide-minimal">

## Training Drills for Attacks

<p class="section-subtitle">How do you train {{ position_name }} attacks?</p>

{% for drill in top.training_drills -%}
### {{ drill.name }}

{{ drill.description }}

{% if drill.duration -%}
**Duration**: {{ drill.duration }}
{% endif %}

{% endfor %}

</section>

{# Flashcards rendered interactively by Flashcard component #}

<section id="position-metrics" class="content-section">

## Success Rates and Statistics

| Metric | Rate |
|--------|------|
| Retention Rate | {{ top.position_metrics.retention_rate.value }}% |
| Advancement Probability | {{ top.position_metrics.advancement_probability.value }}% |
| Submission Probability | {{ top.position_metrics.submission_probability.value }}% |

{% if top.position_metrics.average_time -%}
**Average Time in Position**: {{ top.position_metrics.average_time }}
{% endif %}

</section>

<section id="related-content" class="content-section">

## Related Positions and Techniques

{% for item in top.related_content -%}
- **[[{{ resolve(item.name) }}]]** - {{ item.relationship }}
{% endfor %}

</section>

{{ resolve.related_systems_html(position_name) }}

</main>
