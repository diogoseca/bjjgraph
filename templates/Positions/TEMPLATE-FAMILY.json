    "clips": {
      "type": "array",
      "description": "Curated YouTube film-study clips (position overview/hub-level). Sourced by scripts/source_clips.py, machine-verified, hand-pruned. The content bot must never add, remove, or modify this field.",
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/clip"
      }
