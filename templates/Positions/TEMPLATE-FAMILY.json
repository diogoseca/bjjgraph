{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bjjgraph.org/schemas/position-family.json",
  "title": "BJJ Position Family Schema",
  "description": "JSON Schema for position families WITH variations (Mount, Guards, etc.). Generates hub page + bottom page + top page.",
  "type": "object",
  "required": [
    "name",
    "slug",
    "description",
    "summary",
    "variant_uniqueness",
    "overview",
    "key_principles",
    "variations",
    "related_positions",
    "bottom",
    "top"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Position family name (e.g., 'Mount', 'Closed Guard')",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly slug (e.g., 'mount', 'closed-guard')",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "description": "SEO meta description (150-160 characters)",
      "minLength": 150,
      "maxLength": 160
    },
    "aliases": {
      "type": "array",
      "description": "Strict synonyms — other names for THIS EXACT position family. DO NOT use for variants. See docs/Synonyms.md.",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "family": {
      "type": "string",
      "description": "Name of the variant-family hub this position belongs to. Empty for top-level families. See docs/Synonyms.md."
    },
    "bot_metadata": {
      "type": "object",
      "description": "Automation bookkeeping written by the content bots (not hand-authored). select_oldest_files.sh reads last_improved to skip recently-improved files.",
      "additionalProperties": true,
      "properties": {
        "last_improved": {
          "type": "string",
          "description": "ISO date (YYYY-MM-DD) of the last bot edit"
        },
        "optimization_pass": {
          "type": "string"
        },
        "last_improved_by": {
          "type": "string"
        }
      }
    },
    "sameAs": {
      "type": "array",
      "description": "Authoritative external URLs for THIS technique (Wikipedia article and/or Wikidata entity). schema.org sameAs — feeds Google's Knowledge Graph entity reconciliation and surfaces cross-language names. See docs/Synonyms.md.",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "disambiguations": {
      "type": "array",
      "description": "False-synonym callouts. Renders 'Often confused with X — reason'. Mutual: both pages should declare the other. See docs/Synonyms.md.",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "reason"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "variant_uniqueness": {
      "type": "string",
      "description": "What makes this variant unique - strategic trade-off explanation (20-50 characters)",
      "minLength": 20,
      "maxLength": 50
    },
    "summary": {
      "type": "string",
      "minLength": 30,
      "maxLength": 300,
      "description": "One-sentence, self-contained definition that leads the page (answer-first for AI / featured snippets). ~15-40 words. If present, the overview must NOT repeat it."
    },
    "overview": {
      "type": "string",
      "description": "Comprehensive overview of the position family (400+ words minimum) LEAD with a self-contained one-sentence definition that directly answers 'what is X' before history/context — AI answer engines quote the first sentence; if a summary field is present, start the overview with context instead.",
      "minLength": 400
    },
    "key_principles": {
      "type": "array",
      "description": "Core principles that apply across all variations",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "variations": {
      "type": "array",
      "description": "List of position variations (required for FAMILY template)",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "slug",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Variation name - MUST match filename exactly (Title Case, spaces, apostrophes kept, numbers preserved)",
            "minLength": 1,
            "examples": [
              "High Mount",
              "S Mount Position",
              "Technical Mount",
              "3-4 Mount",
              "Mounted Crucifix"
            ]
          },
          "slug": {
            "type": "string",
            "description": "URL slug - lowercase with spaces→hyphens, apostrophes removed ('High Mount'→'high-mount')",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "examples": [
              "high-mount",
              "s-mount-position",
              "technical-mount",
              "3-4-mount",
              "mounted-crucifix"
            ]
          },
          "description": {
            "type": "string",
            "description": "Brief variation description (10-80 chars)",
            "minLength": 10,
            "maxLength": 80
          }
        },
        "additionalProperties": false
      }
    },
    "flashcards_family": {
      "type": "array",
      "description": "Optional FAMILY-tier flashcards authored ON THE HUB (multi-level hierarchy): principles true across ALL variants of this family. Distinct from the computed aggregate deck; aggregated by regenerate_graph into flashcardTiers.family.",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "answer"
        ],
        "properties": {
          "question": {
            "type": "string",
            "pattern": ".*\\?$",
            "description": "Question about family-wide principles/dynamics"
          },
          "answer": {
            "type": "string",
            "minLength": 50,
            "description": "Detailed answer (50+ characters)"
          },
          "distractors": {
            "type": "object",
            "additionalProperties": false,
            "description": "Optional authored MC distractor tiers (graded options): plausible = nearly-right beginner beliefs, trap = dangerous misconceptions. Rendered by the Neural app's multiple-choice mode; runtime pooling is the fallback when absent.",
            "properties": {
              "plausible": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 15,
                  "maxLength": 200
                }
              },
              "trap": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 15,
                  "maxLength": 200
                }
              }
            }
          },
          "answer_line": {
            "type": "string",
            "maxLength": 60,
            "description": "Optional one-line MC answer / recall cue (<=36 chars target); the full 'answer' stays as the post-reveal detail."
          }
        }
      }
    },
    "flashcards_position": {
      "type": "array",
      "description": "Optional POSITION-tier flashcards (multi-level hierarchy): role-agnostic mechanics of THIS specific position (the family hub is also a base position). Aggregated into flashcardTiers.position.",
      "minItems": 6,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "answer"
        ],
        "properties": {
          "question": {
            "type": "string",
            "pattern": ".*\\?$",
            "description": "Question about this position's role-agnostic mechanics"
          },
          "answer": {
            "type": "string",
            "minLength": 50,
            "description": "Detailed answer (50+ characters)"
          },
          "distractors": {
            "type": "object",
            "additionalProperties": false,
            "description": "Optional authored MC distractor tiers (graded options): plausible = nearly-right beginner beliefs, trap = dangerous misconceptions. Rendered by the Neural app's multiple-choice mode; runtime pooling is the fallback when absent.",
            "properties": {
              "plausible": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 15,
                  "maxLength": 200
                }
              },
              "trap": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 15,
                  "maxLength": 200
                }
              }
            }
          },
          "answer_line": {
            "type": "string",
            "maxLength": 60,
            "description": "Optional one-line MC answer / recall cue (<=36 chars target); the full 'answer' stays as the post-reveal detail."
          }
        }
      }
    },
    "related_positions": {
      "type": "array",
      "description": "Related positions with relationship descriptions",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "relationship"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Related position name",
            "minLength": 1
          },
          "relationship": {
            "type": "string",
            "description": "How this position relates to the main position",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "bottom": {
      "type": "object",
      "description": "Bottom perspective configuration",
      "required": [
        "overview",
        "state_properties",
        "state_invariants",
        "prerequisites",
        "key_principles",
        "transitions",
        "decision_tree",
        "common_errors",
        "training_drills",
        "related_content",
        "position_metrics",
        "name",
        "description",
        "tags"
      ],
      "properties": {
        "overview": {
          "type": "string",
          "description": "Position overview from bottom perspective (400+ words minimum)",
          "minLength": 400
        },
        "state_properties": {
          "type": "object",
          "required": [
            "point_value",
            "position_type",
            "risk_level",
            "energy_cost",
            "time_sustainability"
          ],
          "properties": {
            "point_value": {
              "type": "integer",
              "description": "IBJJF point value (negative for bottom positions)",
              "minimum": -4,
              "maximum": 4
            },
            "position_type": {
              "type": "string",
              "enum": [
                "Offensive",
                "Defensive",
                "Neutral",
                "Offensive/Controlling"
              ]
            },
            "risk_level": {
              "type": "string",
              "enum": [
                "Low",
                "Medium",
                "High"
              ]
            },
            "energy_cost": {
              "type": "string",
              "enum": [
                "Low",
                "Medium",
                "High"
              ]
            },
            "time_sustainability": {
              "type": "string",
              "enum": [
                "Short",
                "Medium",
                "Long"
              ]
            }
          },
          "additionalProperties": false
        },
        "state_invariants": {
          "type": "array",
          "description": "Defining characteristics that must be true for this position",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "prerequisites": {
          "type": "array",
          "description": "Required knowledge/skills for this position",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "key_principles": {
          "type": "array",
          "description": "Core principles for this position (5-7 principles)",
          "minItems": 5,
          "maxItems": 7,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "transitions": {
          "type": "array",
          "description": "Available transitions from this position. attempt_probability MUST sum to 100%",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "transition",
              "attempt_probability"
            ],
            "properties": {
              "transition": {
                "type": "string",
                "description": "Name of the transition technique (must exist as Transition JSON)"
              },
              "attempt_probability": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  {
                    "type": "object",
                    "properties": {
                      "gi": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 0,
                        "maximum": 100
                      },
                      "nogi": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 0,
                        "maximum": 100
                      }
                    },
                    "required": [
                      "gi",
                      "nogi"
                    ],
                    "additionalProperties": false
                  }
                ],
                "description": "Probability this transition is attempted (all must sum to 100%)"
              }
            }
          }
        },
        "decision_tree": {
          "type": "array",
          "description": "Decision tree with conditions and actions (minimum 3 conditions)",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "condition",
              "actions"
            ],
            "properties": {
              "condition": {
                "type": "string",
                "description": "If/when condition",
                "minLength": 10
              },
              "actions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "technique",
                    "target",
                    "probability"
                  ],
                  "properties": {
                    "technique": {
                      "type": "string",
                      "minLength": 3
                    },
                    "target": {
                      "type": "string",
                      "minLength": 3
                    },
                    "probability": {
                      "oneOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100
                        },
                        {
                          "type": "object",
                          "properties": {
                            "gi": {
                              "type": [
                                "integer",
                                "null"
                              ],
                              "minimum": 0,
                              "maximum": 100
                            },
                            "nogi": {
                              "type": [
                                "integer",
                                "null"
                              ],
                              "minimum": 0,
                              "maximum": 100
                            }
                          },
                          "required": [
                            "gi",
                            "nogi"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "common_errors": {
          "type": "array",
          "description": "Common mistakes with corrections (minimum 5)",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": [
              "error",
              "consequence",
              "correction"
            ],
            "properties": {
              "error": {
                "type": "string",
                "minLength": 10
              },
              "consequence": {
                "type": "string",
                "minLength": 10
              },
              "correction": {
                "type": "string",
                "minLength": 10
              }
            },
            "additionalProperties": false
          }
        },
        "training_drills": {
          "type": "array",
          "description": "Training drills (minimum 3)",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "name",
              "description"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 3
              },
              "description": {
                "type": "string",
                "minLength": 10
              },
              "duration": {
                "type": "string",
                "description": "Optional drill duration",
                "examples": [
                  "3 minutes",
                  "5 minutes",
                  "10 minutes"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "related_content": {
          "type": "array",
          "description": "Related positions (minimum 3)",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "name",
              "relationship"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 3
              },
              "relationship": {
                "type": "string",
                "minLength": 10
              }
            },
            "additionalProperties": false
          }
        },
        "position_metrics": {
          "type": "object",
          "required": [
            "retention_rate",
            "advancement_probability",
            "submission_probability",
            "average_time"
          ],
          "properties": {
            "retention_rate": {
              "type": "object",
              "required": [
                "value"
              ],
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "description": {
                  "type": "string",
                  "minLength": 10
                }
              },
              "additionalProperties": false
            },
            "advancement_probability": {
              "type": "object",
              "required": [
                "value"
              ],
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "description": {
                  "type": "string",
                  "minLength": 10
                }
              },
              "additionalProperties": false
            },
            "submission_probability": {
              "type": "object",
              "required": [
                "value"
              ],
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "description": {
                  "type": "string",
                  "minLength": 10
                }
              },
              "additionalProperties": false
            },
            "average_time": {
              "type": "string",
              "description": "Typical duration in position",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "name": {
          "type": "string",
          "description": "Position name with perspective (e.g., 'Mount Bottom')",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "SEO meta description (150-160 characters)",
          "minLength": 150,
          "maxLength": 160
        },
        "tags": {
          "type": "array",
          "description": "SEO tags",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "clips": {
          "type": "array",
          "description": "Curated YouTube film-study clips (playing bottom). Sourced by scripts/source_clips.py, machine-verified, hand-pruned. The content bot must never add, remove, or modify this field.",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/clip"
          }
        }
      },
      "additionalProperties": false
    },
    "top": {
      "type": "object",
      "description": "Top perspective configuration (same structure as bottom)",
      "required": [
        "overview",
        "state_properties",
        "state_invariants",
        "prerequisites",
        "key_principles",
        "transitions",
        "decision_tree",
        "common_errors",
        "training_drills",
        "related_content",
        "position_metrics",
        "name",
        "description",
        "tags"
      ],
      "properties": {
        "overview": {
          "type": "string",
          "description": "Position overview from top perspective (400+ words minimum)",
          "minLength": 400
        },
        "state_properties": {
          "type": "object",
          "required": [
            "point_value",
            "position_type",
            "risk_level",
            "energy_cost",
            "time_sustainability"
          ],
          "properties": {
            "point_value": {
              "type": "integer",
              "description": "IBJJF point value (positive for top positions)",
              "minimum": -4,
              "maximum": 4
            },
            "position_type": {
              "type": "string",
              "enum": [
                "Offensive",
                "Defensive",
                "Neutral",
                "Offensive/Controlling"
              ]
            },
            "risk_level": {
              "type": "string",
              "enum": [
                "Low",
                "Medium",
                "High"
              ]
            },
            "energy_cost": {
              "type": "string",
              "enum": [
                "Low",
                "Medium",
                "High"
              ]
            },
            "time_sustainability": {
              "type": "string",
              "enum": [
                "Short",
                "Medium",
                "Long"
              ]
            }
          },
          "additionalProperties": false
        },
        "state_invariants": {
          "type": "array",
          "description": "Defining characteristics that must be true for this position",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "prerequisites": {
          "type": "array",
          "description": "Required knowledge/skills for this position",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "key_principles": {
          "type": "array",
          "description": "Core principles for this position (5-7 principles)",
          "minItems": 5,
          "maxItems": 7,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "transitions": {
          "type": "array",
          "description": "Available transitions from this position. attempt_probability MUST sum to 100%",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "transition",
              "attempt_probability"
            ],
            "properties": {
              "transition": {
                "type": "string",
                "description": "Name of the transition technique (must exist as Transition JSON)"
              },
              "attempt_probability": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  {
                    "type": "object",
                    "properties": {
                      "gi": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 0,
                        "maximum": 100
                      },
                      "nogi": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 0,
                        "maximum": 100
                      }
                    },
                    "required": [
                      "gi",
                      "nogi"
                    ],
                    "additionalProperties": false
                  }
                ],
                "description": "Probability this transition is attempted (all must sum to 100%)"
              }
            }
          }
        },
        "decision_tree": {
          "type": "array",
          "description": "Decision tree with conditions and actions (minimum 3 conditions)",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "condition",
              "actions"
            ],
            "properties": {
              "condition": {
                "type": "string",
                "description": "If/when condition",
                "minLength": 10
              },
              "actions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "technique",
                    "target",
                    "probability"
                  ],
                  "properties": {
                    "technique": {
                      "type": "string",
                      "minLength": 3
                    },
                    "target": {
                      "type": "string",
                      "minLength": 3
                    },
                    "probability": {
                      "oneOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100
                        },
                        {
                          "type": "object",
                          "properties": {
                            "gi": {
                              "type": [
                                "integer",
                                "null"
                              ],
                              "minimum": 0,
                              "maximum": 100
                            },
                            "nogi": {
                              "type": [
                                "integer",
                                "null"
                              ],
                              "minimum": 0,
                              "maximum": 100
                            }
                          },
                          "required": [
                            "gi",
                            "nogi"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "common_errors": {
          "type": "array",
          "description": "Common mistakes with corrections (minimum 5)",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": [
              "error",
              "consequence",
              "correction"
            ],
            "properties": {
              "error": {
                "type": "string",
                "minLength": 10
              },
              "consequence": {
                "type": "string",
                "minLength": 10
              },
              "correction": {
                "type": "string",
                "minLength": 10
              }
            },
            "additionalProperties": false
          }
        },
        "training_drills": {
          "type": "array",
          "description": "Training drills (minimum 3)",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "name",
              "description"
            ],
            "properties": {
              "name": {
