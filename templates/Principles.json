{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BJJ Principle Template Schema V3",
  "description": "Concise BJJ principle reference with practical examples, mistakes, and training approaches.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "tags",
    "application_level",
    "complexity_level",
    "development_timeline",
    "overview",
    "key_principles",
    "component_skills",
    "principle_relationships",
    "application_contexts",
    "decision_framework",
    "common_errors",
    "training_approaches",
    "developmental_metrics",
    "related_content",
    "summary",
    "flashcards",
    "graph_applicability"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Principle name (must match filename without .json)",
      "minLength": 3,
      "examples": [
        "Base Maintenance",
        "Action and Reaction"
      ]
    },
    "description": {
      "type": "string",
      "description": "Plain one-sentence description for search previews. Describe the principle without promotional copy.",
      "minLength": 70,
      "maxLength": 180,
      "examples": [
        "Base is the support that keeps you balanced while you move, apply pressure, or resist a sweep."
      ]
    },
    "tags": {
      "type": "array",
      "description": "Content tags (minimum 3)",
      "minItems": 3,
      "items": {
        "type": "string"
      },
      "examples": [
        [
          "bjj",
          "principle",
          "base",
          "stability"
        ]
      ]
    },
    "aliases": {
      "type": "array",
      "description": "Strict synonyms — other names for THIS EXACT principle. See docs/Synonyms.md.",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "family": {
      "type": "string",
      "description": "Name of a parent family hub. Usually empty for principles."
    },
    "bot_metadata": {
      "type": "object",
      "description": "Automation bookkeeping written by the content bots (not hand-authored). select_oldest_files.sh reads last_improved to skip recently-improved files.",
      "additionalProperties": true,
      "properties": {
        "last_improved": {
          "type": "string",
          "description": "ISO date (YYYY-MM-DD) of the last bot edit"
        },
        "optimization_pass": {
          "type": "string"
        },
        "last_improved_by": {
          "type": "string"
        }
      }
    },
    "sameAs": {
      "type": "array",
      "description": "Authoritative external URLs for THIS principle (Wikipedia/Wikidata). schema.org sameAs. See docs/Synonyms.md.",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "disambiguations": {
      "type": "array",
      "description": "False-synonym callouts. Renders 'Often confused with X — reason'. See docs/Synonyms.md.",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "reason"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "application_level": {
      "type": "string",
      "enum": [
        "Fundamental",
        "Intermediate",
        "Advanced",
        "Expert"
      ],
      "description": "When this principle becomes relevant"
    },
    "complexity_level": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High"
      ]
    },
    "development_timeline": {
      "type": "string",
      "examples": [
        "Beginner to Advanced",
        "Intermediate to Expert"
      ]
    },
    "summary": {
      "type": "string",
      "description": "One self-contained definition sentence, roughly 15-35 words. Lead with what the principle means; avoid promotional claims.",
      "minLength": 30,
      "maxLength": 260
    },
    "overview": {
      "type": "string",
      "description": "One or two practical sentences that add an application cue to the summary. No history, generic praise, or repeated definition.",
      "minLength": 40,
      "examples": [
        "Move your feet, knees, or hands as pressure changes so your weight stays supported. Widen your base to resist a sweep, then adjust it as you move."
      ],
      "maxLength": 320
    },
    "key_principles": {
      "type": "array",
      "description": "3-5 distinct actionable points, most useful first. Each point should be one short sentence.",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 10,
        "maxLength": 160
      }
    },
    "component_skills": {
      "type": "array",
      "description": "5-8 discrete sub-skills (50+ character descriptions)",
      "minItems": 5,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skill_name",
          "description"
        ],
        "properties": {
          "skill_name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 50
          }
        }
      }
    },
    "principle_relationships": {
      "type": "array",
      "description": "Network of related principles (3-15 items)",
      "minItems": 3,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "principle_name",
          "relationship_type",
          "description"
        ],
        "properties": {
          "principle_name": {
            "type": "string"
          },
          "relationship_type": {
            "type": "string",
            "enum": [
              "Prerequisite",
              "Complementary",
              "Extension",
              "Alternative",
              "Advanced form"
            ]
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "application_contexts": {
      "type": "array",
      "description": "3-5 distinct examples. Name the position or situation and explain the concrete action in one short sentence.",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "context",
          "how_applied"
        ],
        "properties": {
          "context": {
            "type": "string",
            "description": "Position or scenario where principle applies",
            "minLength": 1,
            "maxLength": 90
          },
          "how_applied": {
            "type": "string",
            "description": "How principle manifests in this context",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "decision_framework": {
      "type": "array",
      "description": "6-8 steps for applying the principle",
      "minItems": 6,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_number",
          "decision_point",
          "action"
        ],
        "properties": {
          "step_number": {
            "type": "integer",
            "minimum": 1
          },
          "decision_point": {
            "type": "string"
          },
          "action": {
            "type": "string"
          }
        }
      }
    },
    "common_errors": {
      "type": "array",
      "description": "3-4 distinct mistakes, most useful first. Use a short label, a brief consequence, and a practical correction.",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "consequence",
          "correction"
        ],
        "properties": {
          "error": {
            "type": "string",
            "minLength": 1,
            "maxLength": 90
          },
          "consequence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "correction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "maxItems": 4
    },
    "training_approaches": {
      "type": "array",
      "description": "2-3 focused drills, easiest useful starting drill first. Give a setup, action, and reset or stop condition; avoid resisted finishing pressure on joints or the neck.",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "approach_name",
          "description",
          "focus"
        ],
        "properties": {
          "approach_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 260
          },
          "focus": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
    },
    "developmental_metrics": {
      "type": "array",
      "description": "Observable skill markers at 4 levels (exactly 4)",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "observable_behaviors"
        ],
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "Beginner",
              "Intermediate",
              "Advanced",
              "Expert"
            ]
          },
          "observable_behaviors": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "related_content": {
      "type": "array",
      "description": "Related positions/transitions/principles (3-15 items)",
      "minItems": 3,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "content_type",
          "relationship"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "content_type": {
            "type": "string",
            "enum": [
              "Position",
              "Transition",
              "Submission",
              "Principle",
              "System"
            ]
          },
          "relationship": {
            "type": "string"
          }
        }
      }
    },
    "flashcards": {
      "type": "array",
      "description": "Q&A flashcards for self-assessment and SRS training (optional, 6-12 recommended)",
      "minItems": 6,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "answer"
        ],
        "properties": {
          "question": {
            "type": "string",
            "pattern": ".*\\?$",
            "description": "Question about the principle, its application, or recognition"
          },
          "answer": {
            "type": "string",
            "minLength": 50,
            "description": "Detailed answer (50+ characters)"
          },
          "distractors": {
            "type": "object",
            "additionalProperties": false,
            "description": "Optional authored MC distractor tiers (graded options): plausible = nearly-right beginner beliefs, trap = dangerous misconceptions. Rendered by the Neural app's multiple-choice mode; runtime pooling is the fallback when absent.",
            "properties": {
              "plausible": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 200
                }
              },
              "trap": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 200
                }
              }
            }
          },
          "answer_line": {
            "type": "string",
            "maxLength": 60,
            "description": "Optional one-line MC answer / recall cue (<=36 chars target); the full 'answer' stays as the post-reveal detail."
          }
        }
      }
    },
    "clips": {
      "type": "array",
      "description": "Curated YouTube film-study clips (principle film-study). Sourced by scripts/source_clips.py, machine-verified, hand-pruned. The content bot must never add, remove, or modify this field.",
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/clip"
      }
    },
    "graph_applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "rationale"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "all",
            "specific"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 30
        },
        "terms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          },
          "maxItems": 24
        },
        "families": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    }
  },
  "$defs": {
    "clip": {
      "type": "object",
      "description": "One curated YouTube film-study clip. Machine-verified by scripts/source_clips.py / verify_clips.py; pruned by hand. NEVER AI-authored.",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{11}$",
          "description": "YouTube video ID (11 chars)"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80,
          "description": "Short display title for the clip"
        },
        "by": {
          "type": "string",
          "description": "Display credit — the instructor/legend teaching the clip"
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "description": "Loop start in seconds (default 0)"
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "description": "Loop end in seconds; omit to play the full video"
        },
        "vertical": {
          "type": "boolean",
          "description": "True for YouTube Shorts / portrait video"
        },
        "channel": {
          "type": "string",
          "description": "Provenance: uploader channel name from search"
        },
        "duration": {
          "type": "integer",
          "minimum": 1,
          "description": "Provenance: full video duration in seconds"
        },
        "verified": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Provenance: date of last machine verification (oEmbed + shorts check)"
        },
        "upload_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Provenance: video publish date. Filled by a future yt-dlp enrichment pass (residential IP; per-video fetches are bot-checked from datacenter IPs). When present, emitted as VideoObject.uploadDate in generated markdown."
        }
      }
    }
  }
}
