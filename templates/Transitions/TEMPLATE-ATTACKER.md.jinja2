{# BJJ Transition Attacker Page Template #}
{# Generates attacker perspective pages from attacker section #}
{# Input: attacker (full attacker section), name (hub name), from_position, outcomes #}

---
title: "{{ name }} Attacker | BJJ Technique Guide | BJJ Graph"
description: "{{ attacker.description }}"
---

{# PostHog A/B Testing Metadata #}
<body data-content-type="transitions">

<!-- Schema Markup - HowTo for Execution -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Execute {{ name }} in BJJ",
  "description": "Step-by-step guide for executing {{ name }} from {{ from_position }}.",
  "step": [
    {%- for step in attacker.execution_steps[:8] %}
    {
      "@type": "HowToStep",
      "name": "{{ step.action }}",
      "text": "{{ step.description }}",
      "position": {{ loop.index }}
    }{{ "," if not loop.last else "" }}
    {%- endfor %}
  ],
  "tool": ["BJJ Gi or No-Gi attire", "Training partner", "Mat space"],
  "totalTime": "PT5M"
}
</script>

<!-- Schema Markup - FAQ from Knowledge Assessment -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for qa in attacker.flashcards[:6] %}
    {
      "@type": "Question",
      "name": "{{ qa.question }}",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "{{ qa.answer }}"
      }
    }{{ "," if not loop.last else "" }}
    {%- endfor %}
  ]
}
</script>

<!-- Schema Markup - WebPage -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "{{ name }} Attacker",
  "description": "{{ attacker.description }}",
  {%- if aliases is defined and aliases %}
  "alternateName": [{% for alias in aliases %}{{ alias | tojson }}{{ ", " if not loop.last else "" }}{% endfor %}],
  {%- endif %}
  {%- if disambiguations is defined and disambiguations %}
  {%- set _ns = namespace(dd='') %}
  {%- for d in disambiguations %}{% set _ns.dd = _ns.dd + 'Often confused with ' + d.name + ' — ' + d.reason + '.' + (' ' if not loop.last else '') %}{% endfor %}
  "disambiguatingDescription": {{ _ns.dd | tojson }},
  {%- endif %}
  {%- if sameAs is defined and sameAs %}
  "sameAs": [{% for u in sameAs %}{{ u | tojson }}{{ ", " if not loop.last else "" }}{% endfor %}],
  {%- endif %}
  "isPartOf": {
    "@type": "WebSite",
    "name": "BJJ Graph",
    "url": "https://bjjgraph.org"
  }{%- if family is defined and family %},
  "mainEntityOfPage": {
    "@type": "CollectionPage",
    "name": "{{ family }}",
    "url": "https://bjjgraph.org/Families/{{ family | slugify }}"
  }
  {%- endif %}
}
</script>

<!-- Schema Markup - Breadcrumbs -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://bjjgraph.org/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Transitions",
      "item": "https://bjjgraph.org/Transitions/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "{{ name }}",
      "item": "https://bjjgraph.org/Transitions/{{ name.replace(' ', '-') }}"
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": "Attacker",
      "item": "https://bjjgraph.org/Transitions/{{ name.replace(' ', '-') }}/Attacker"
    }
  ]
}
</script>

{# Flexbox wrapper for A/B testing #}
<main class="content-wrapper" style="display: flex; flex-direction: column;">

{% if (aliases is defined and aliases) or (family is defined and family) or (disambiguations is defined and disambiguations) -%}
<aside class="entity-relations">
{%- if aliases is defined and aliases %}
<p class="also-known-as"><em>Also known as:</em> {% for alias in aliases %}<strong>{{ alias | e }}</strong>{{ ", " if not loop.last else "" }}{% endfor %} <span class="role-hint">(attacker)</span></p>
{%- endif %}
{%- if family is defined and family %}
<p class="part-of-family"><em>Part of the</em> <strong>{% if resolve.family_exists(family) %}[[Families/{{ family }}|{{ family | e }}]]{% else %}{{ family | e }}{% endif %}</strong> <em>family</em></p>
{%- endif %}
{%- if disambiguations is defined and disambiguations %}
{%- for d in disambiguations %}
<p class="often-confused-with"><em>Often confused with</em> <strong>{% if resolve.page_exists(d.name) %}[[{{ resolve(d.name) }}|{{ d.name | e }}]]{% else %}{{ d.name | e }}{% endif %}</strong> — {{ d.reason | e }}</p>
{%- endfor %}
{%- endif %}
</aside>
{% endif -%}

<section id="overview" class="content-section">

{{ attacker.overview }}

**From Position**: [[{{ resolve(from_position.split('/')[0]) }}]] ({{ from_position.split('/')[1] if '/' in from_position else '' }})

</section>

<section id="key-principles" class="content-section">

## Key Attacking Principles

<p class="section-subtitle">What are the key principles for executing {{ name }}?</p>

{% for principle in attacker.key_principles -%}
- {{ principle }}
{% endfor %}

</section>

<section id="setup-requirements" class="content-section">

## Prerequisites

<p class="section-subtitle">What do you need before attempting {{ name }}?</p>

{% for req in attacker.setup_requirements -%}
- {{ req }}
{% endfor %}

</section>

<section id="execution-steps" class="content-section">

## Execution Steps

<p class="section-subtitle">How do you execute {{ name }} step by step?</p>

{% for step in attacker.execution_steps -%}
{{ step.step_number }}. **{{ step.action }}**: {{ step.description }}
{% endfor %}

</section>

<section id="possible-outcomes" class="content-section">

## Possible Outcomes

| Result | Position | Probability |
|--------|----------|-------------|
{% for outcome in outcomes -%}
| {{ outcome.result | capitalize }} | [[{{ resolve(outcome.to.split('/')[0] if '/' in outcome.to else outcome.to) }}]] | {{ outcome.probability }}% |
{% endfor %}

</section>

<section id="common-counters" class="content-section">

## Opponent Counters

<p class="section-subtitle">How might your opponent counter {{ name }}?</p>

{% for counter in attacker.common_counters -%}
- **{{ counter.counter }}** (Effectiveness: {{ counter.effectiveness }}){% if counter.your_response %} - Your Response: {{ counter.your_response }}{% endif %}{% if counter.targets_outcome %} → Leads to [[{{ resolve(counter.targets_outcome.split('/')[0] if '/' in counter.targets_outcome else counter.targets_outcome) }}]]{% endif %}
{% endfor %}

</section>

<section id="common-mistakes" class="content-section hide-minimal">

## Common Attacking Mistakes

<p class="section-subtitle">What mistakes should you avoid when executing {{ name }}?</p>

{% for error in attacker.common_errors -%}
### {{ loop.index }}. {{ error.error }}

- **Consequence**: {{ error.consequence }}
- **Correction**: {{ error.correction }}

{% endfor %}

</section>

<section id="training-progressions" class="content-section hide-minimal">

## Training Progressions

<p class="section-subtitle">How do you train {{ name }} (Attacker)?</p>

{% for progression in attacker.training_progressions -%}
**{{ progression.phase }}** - {{ progression.focus }}
{{ progression.description }}

{% endfor %}

</section>

{# Knowledge assessment rendered as interactive flashcards by TransitionFlashcard component #}

<section id="safety-considerations" class="content-section">

## Safety Considerations

<p class="section-subtitle">What are the safety concerns for {{ name }}?</p>

{{ attacker.safety_considerations }}

</section>

{{ resolve.related_systems_html(name) }}

</main>
