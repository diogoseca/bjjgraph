{# Course-first guide. Source links stay canonical; built output resolves attribution. #}
---
title: {{ ((guide.display_title if guide else name) ~ " | BJJGraph") | jsonstr }}
description: {{ description | jsonstr }}
---
{% set live = namespace(products=[]) %}
{% for p in products | default([]) %}{% if p.link_status == 'live' and p.course_url | default('') | canonical_course_url %}{% set live.products = live.products + [p] %}{% endif %}{% endfor %}
{% set primary = live.products[0] if live.products else none %}
{% macro course_cta(placement) %}
<section class="system-course system-course--{{ placement }}" data-course-container data-course-placement="{{ placement }}"{% if placement == 'top' %} id="unlock-this-system"{% endif %}>
<a class="system-course__link" href="{{ primary.course_url | e }}" data-course-url="{{ primary.course_url | e }}" data-product-id="{{ primary.id | default('') | e }}" data-system-slug="systems/{{ name | slugify }}" data-system-name="{{ name | e }}" data-vendor="{{ primary.vendor | default('') | lower | e }}" data-placement="{{ placement }}" data-affiliate="false" target="_blank" rel="noopener">{% if placement == 'top' %}<h2>{{ primary.title | e }}</h2>{% if primary.instructor %}<span class="system-course__instructor">By {{ primary.instructor | e }}</span>{% endif %} <span class="system-course__button">View course{% if primary.course_url is bjjfanatics %} on BJJ Fanatics{% endif %}</span>{% elif placement == 'mid' %}{{ primary.title | e }} · View course{% else %}Go to this course: {{ primary.title | e }}{% endif %}</a>
</section>
{% endmacro %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"WebPage","name":{{ (guide.display_title if guide else name) | jsonstr }},"description":{{ description | jsonstr }}}
</script>
<main class="system-guide" data-system-guide data-system-key="{{ name | e }}">
<a class="system-back" href="/Systems">Back to Systems</a>
<header class="system-heading">
<h1>{{ (guide.display_title if guide else name) | e }}</h1>
<div class="system-tags"><span>{{ system_type | e }}</span><span>{{ difficulty_level | e }}</span></div>
{% set graph_refs = related_content | selectattr('content_type', 'in', ['Position', 'Transition', 'Submission']) | map(attribute='name') | unique | list %}
<p class="system-reference-count">{{ graph_refs | length }} related references (techniques and positions)</p>
</header>
{% if primary %}{{ course_cta('top') }}{% endif %}
<section id="overview" class="system-overview">

{{ overview }}

</section>
{% if guide and guide.preview %}
{% set preview = guide.preview %}
<section id="official-preview" class="system-preview" data-system-preview data-system-key="{{ name | e }}" data-provider="{{ preview.provider | e }}" data-embed-url="{{ preview.embed_url | e }}" data-verified-origins="{{ preview.playback_verified_on | tojson | forceescape }}" data-preview-title="{{ preview.title | e }}">
<h2>{{ 'Official trailer' if preview.kind == 'trailer' else 'Official sample' }}</h2>
<p>{{ preview.title | e }}</p>
<div id="system-preview-player" data-preview-player data-persist></div>
<p data-preview-fallback>Watch the {{ preview.kind | e }} on the official page{% if not primary %} linked in <a href="#sources">Sources</a>{% endif %}.</p>
</section>
{% if primary %}{{ course_cta('mid') }}{% endif %}
{% endif %}
{% if guide %}
<span id="is-this-useful-for-you"></span><span id="start-here"></span><span id="study-this-system"></span>
<section id="fit" class="system-section">

## Is this for you?

{% for item in guide.audience.fits %}- {{ item }}
{% endfor %}
{% if guide.audience.consider_alternative_if %}
### Consider an alternative if

{% for item in guide.audience.consider_alternative_if %}- {{ item }}
{% endfor %}
{% endif %}
{% if guide.alternatives %}
<h3>Also consider</h3>
{% for item in guide.alternatives %}<p><a href="{{ item.url | e }}">{{ item.title | e }}</a> — {{ item.reason | e }}</p>{% endfor %}
{% endif %}
{% if guide.audience.prerequisites %}
### Prerequisites

{% for item in guide.audience.prerequisites %}- {{ item }}
{% endfor %}
{% endif %}
</section>
<span id="key-principles"></span><span id="key-components"></span>
<span id="implementation-sequence"></span><span id="training-methodology"></span>
<span id="common-obstacles"></span><span id="assessment-metrics"></span>
<span id="what-the-sources-cover"></span>
<section id="coverage" class="system-section">

## Coverage and limits

{% for item in guide.coverage.includes %}- {{ item }}
{% endfor %}

### Limits

{% for item in guide.coverage.limits %}- {{ item }}
{% endfor %}
</section>
{% elif key_principles %}
<section id="key-principles" class="system-section">

## Key principles

{% for item in key_principles %}- {{ item }}
{% endfor %}
</section>
{% endif %}
{% if primary %}{{ course_cta('end') }}{% endif %}
<section id="related-content" class="system-section">

## Related guides and principles

These related references are not a claim about what the course teaches or evidence of practical mastery.

{% for item in references | default([]) %}{% set relationship = item | guide_relationship if guide else item.relationship %}<p><a href="{{ item.url | e }}">{{ item.name | e }}</a>{% if relationship %} — {{ relationship | e }}{% endif %}</p>{% endfor %}

### Review related technique cards

{% for item in related_content if item.content_type in ['Position', 'Transition', 'Submission'] %}
{% set relationship = item | guide_relationship if guide else item.relationship %}
- [[{{ resolve(item.name) }}|{{ item.name }}]] ({{ item.content_type }}){% if relationship %} — {{ relationship }}{% endif %}
{% endfor %}
</section>
<span id="sources-and-evidence"></span>
<section id="sources" class="system-sources">
<details><summary>Sources <span class="system-sources__hint">Expand for evidence and notes</span></summary>
<p class="system-attribution">Independent BJJGraph guide. Not authored or endorsed by the instructor.</p>
{% if guide and guide.preview and not guide.preview.content_reviewed %}<p>The sample's instructional content has not been reviewed by BJJGraph.</p>{% endif %}
{% if guide %}{% for source in guide.sources %}
<section class="system-source" data-source-container>
<p><a href="{{ source.url | e }}"{% if source.url is bjjfanatics %} data-source-url="{{ source.url | e }}" data-affiliate="false" data-system-slug="systems/{{ name | slugify }}" data-product-id="{{ source.id | e }}"{% endif %} target="_blank" rel="noopener">{{ source.title | e }}</a> — {{ source.kind | replace('_', ' ') | e }}; checked {{ source.checked_on | e }}. {{ source.note | e }}{% if source.viewed_range %} Inspected: {{ source.viewed_range | e }}{% endif %}</p>
</section>
{% endfor %}{% endif %}
</details>
</section>
</main>
