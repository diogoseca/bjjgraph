{# Independent source-grounded guide. Affiliate state is built-only. #}
---
title: {{ ((guide.display_title if guide else name) ~ " | BJJGraph") | jsonstr }}
description: {{ description | jsonstr }}
---

{% set live = namespace(products=[]) %}
{% for p in products | default([]) %}
{% if p.link_status == 'live' and p.course_url | default('') | canonical_course_url %}
{% set live.products = live.products + [p] %}
{% endif %}
{% endfor %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"WebPage","name":{{ (guide.display_title if guide else name) | jsonstr }},"description":{{ description | jsonstr }}}
</script>
<main class="content-wrapper" data-system-guide>
<p class="system-attribution">Independent BJJGraph {{ 'course companion' if guide and guide.kind == 'course_companion' else 'study guide' }}. Not authored or endorsed by the instructor.{% if live.products %} Course: {{ live.products[0].title | e }}{% if live.products[0].instructor %} by {{ live.products[0].instructor | e }}{% endif %}.{% endif %}</p>
<section id="overview" class="content-section">

## {{ guide.display_title if guide else name }}

{% if summary %}**{{ summary }}**

{% endif %}
{{ overview }}

</section>
{% if guide %}
<section id="fit" class="content-section">

## Is this useful for you?

{% for item in guide.audience.fits %}- {{ item }}
{% endfor %}

### Consider an alternative if

{% for item in guide.audience.consider_alternative_if %}- {{ item }}
{% endfor %}
{% if guide.audience.prerequisites %}
### Prerequisites

{% for item in guide.audience.prerequisites %}- {{ item }}
{% endfor %}
{% endif %}
</section>
<span id="implementation-sequence"></span><span id="training-methodology"></span><span id="study-this-system"></span>
<section id="start-here" class="content-section">

## Start here: {{ guide.start_here.title }}

{{ guide.start_here.task }}

{% if guide.start_here.section %}Published section: {{ guide.start_here.section }}
{% endif %}
{% if guide.start_here.kind == 'practice' %}
- **Start position:** {{ guide.start_here.start_position }}
- **Partner task:** {{ guide.start_here.partner_task }}
- **Stop condition:** {{ guide.start_here.stop_condition }}
{% endif %}
{% for source in guide.sources if source.id in guide.start_here.source_ids %}
<p>Source: <a href="{{ source.url | e }}" target="_blank" rel="noopener">{{ source.title | e }}</a></p>
{% endfor %}
</section>
{% if guide.preview %}
{% set preview = guide.preview %}
<section id="official-preview" class="content-section" data-system-preview data-provider="{{ preview.provider | e }}" data-embed-url="{{ preview.embed_url | e }}" data-verified-origins="{{ preview.playback_verified_on | tojson | forceescape }}" data-preview-title="{{ preview.title | e }}">
<h2>{{ preview.title | e }}</h2>
<p>{{ 'Official trailer' if preview.kind == 'trailer' else 'Official public sample' }}. {% if not preview.content_reviewed %}The sample's instructional content has not been reviewed by BJJGraph.{% endif %}</p>
<button type="button" data-load-preview hidden>Load official {{ 'trailer' if preview.kind == 'trailer' else 'sample' }}</button>
<div data-preview-player></div>
{% for source in guide.sources if source.id == preview.source_id %}<p><a href="{{ source.url | e }}" target="_blank" rel="noopener">Watch on the official page: {{ source.title | e }}</a></p>{% endfor %}
</section>
{% endif %}
{% endif %}
{% if live.products %}
<section id="unlock-this-system" class="content-section product-cards" data-course-container>
<h2>Course reference</h2>
{% set p = live.products[0] %}
<article class="product-card">
<h3>{{ p.title | e }}</h3>
{% if p.instructor %}<p>By {{ p.instructor | e }}</p>{% endif %}
{% if not guide %}{% for field in ['best_for', 'blurb', 'study_focus', 'practice_tip'] %}{% if p[field] %}<p>{{ p[field] | e }}</p>{% endif %}{% endfor %}{% endif %}
<p><a href="{{ p.course_url | e }}" data-course-url="{{ p.course_url | e }}" data-product-id="{{ p.id | default('') | e }}" data-system-slug="systems/{{ name | slugify }}" data-system-name="{{ name | e }}" data-vendor="{{ p.vendor | default('BJJFanatics') | lower | e }}" data-placement="overview" data-affiliate="false" target="_blank" rel="noopener">View course and syllabus</a></p>
</article>
{% for p in live.products[1:3] %}
<p>Related course: <a href="{{ p.course_url | e }}" data-course-url="{{ p.course_url | e }}" data-product-id="{{ p.id | default('') | e }}" data-system-slug="systems/{{ name | slugify }}" data-system-name="{{ name | e }}" data-vendor="{{ p.vendor | default('BJJFanatics') | lower | e }}" data-placement="related" data-affiliate="false" rel="noopener" target="_blank">{{ p.title | e }}{% if p.instructor %} — {{ p.instructor | e }}{% endif %}</a></p>
{% endfor %}
</section>
{% endif %}
{% if guide %}
<span id="key-principles"></span><span id="key-components"></span>
<section id="coverage" class="content-section">

## What the sources cover

{% for item in guide.coverage.includes %}- {{ item }}
{% endfor %}
<span id="common-obstacles"></span><span id="assessment-metrics"></span>

### Limits

{% for item in guide.coverage.limits %}- {{ item }}
{% endfor %}
</section>
<section id="sources" class="content-section">
<h2>Sources and evidence</h2>
{% for source in guide.sources %}<p><a href="{{ source.url | e }}" target="_blank" rel="noopener">{{ source.title | e }}</a> — {{ source.kind | replace('_', ' ') | e }}; checked {{ source.checked_on | e }}. {{ source.note | e }}{% if source.viewed_range %} Inspected: {{ source.viewed_range | e }}{% endif %}</p>{% endfor %}
</section>
{% else %}

{% if key_principles %}
<section id="key-principles" class="content-section">

## Core Principles
{% for principle in key_principles -%}
- {{principle}}
{% endfor %}

</section>
{% endif %}

{% if key_components %}
<section id="key-components" class="content-section">

## Key Components
{% for component in key_components -%}
**{{component.component_name}}** ({{component.purpose}})
{{component.description}}

{% endfor %}

</section>
{% endif %}

{% if implementation_sequence %}
<section id="implementation-sequence" class="content-section">

## Implementation Sequence
{% for step in implementation_sequence -%}
{{step.step_number}}. **{{step.phase}}**: {{step.description}}
{% if step.key_points -%}
Key points:
{% for point in step.key_points -%}
  - {{point}}
{% endfor %}
{% endif %}

{% endfor %}

</section>
{% endif %}

{% if common_obstacles %}
<section id="common-obstacles" class="content-section hide-minimal">

## What Challenges Will You Face?
{% for obstacle in common_obstacles -%}
- **{{obstacle.obstacle}}**: {{obstacle.solution}}
{% endfor %}

</section>
{% endif %}

{% if assessment_metrics %}
<section id="assessment-metrics" class="content-section">

## How to Measure Your Progress
{% for metric in assessment_metrics -%}
**{{metric.metric_name}}**: {{metric.description}}
Proficiency indicators:
{% for indicator in metric.proficiency_indicators -%}
- {{indicator}}
{% endfor %}

{% endfor %}

</section>
{% endif %}

{% if training_methodology %}
<section id="training-methodology" class="content-section hide-minimal">

## How to Train This System Effectively

### Drilling Approach
{{training_methodology.drilling_approach}}

### Progression Path
{% for stage in training_methodology.progression_path -%}
**{{stage.stage}}** (Focus: {{stage.focus}}){% if stage.timeframe %} - {{stage.timeframe}}{% endif %}
{% endfor %}

### Common Mistakes
{% for mistake in training_methodology.common_mistakes -%}
- {{mistake}}
{% endfor %}

</section>
{% endif %}

{% endif %}
<section id="related-content" class="content-section">

## Related references and alternatives

{% if guide %}
{% for item in references | default([]) %}<p><a href="{{ item.url | e }}">{{ item.name | e }}</a> ({{ item.type | e }}) — {{ item.relationship | e }}</p>{% endfor %}
{% endif %}

### Review related technique cards

These references connect this guide to BJJGraph's technique pages; they do not establish what an instructor teaches or measure proficiency.

{% for item in related_content if not guide or item.content_type not in ['System', 'Principle'] %}
- [[{{ resolve(item.name) }}|{{ item.name }}]] ({{ item.content_type }}) — {{ item.relationship }}
{% endfor %}
</section>
</main>
