{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BJJ Systems Template Schema V3",
  "description": "Standardized JSON schema for BJJ system pages - strict 10-section structure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "tags",
    "system_type",
    "difficulty_level",
    "overview",
    "key_principles",
    "key_components",
    "implementation_sequence",
    "common_obstacles",
    "assessment_metrics",
    "training_methodology",
    "related_content"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "System name (must match filename without .json)",
      "minLength": 3,
      "examples": [
        "Kimura Trap System",
        "Danaher Leg Lock System"
      ]
    },
    "description": {
      "type": "string",
      "description": "SEO meta description 150-160 characters",
      "minLength": 140,
      "maxLength": 180,
      "examples": [
        "Master Kimura Trap System in BJJ. Comprehensive framework connecting control to submissions and back takes. Danaher's systematic approach."
      ]
    },
    "tags": {
      "type": "array",
      "description": "Content tags (minimum 3)",
      "minItems": 3,
      "items": {
        "type": "string"
      },
      "examples": [
        [
          "bjj",
          "system",
          "kimura",
          "submission-chain"
        ]
      ]
    },
    "aliases": {
      "type": "array",
      "description": "Strict synonyms — other names for THIS EXACT system. Examples: ['DDS', 'Modern Leg Locks'] for Danaher Leg Lock System. See docs/Synonyms.md.",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "family": {
      "type": "string",
      "description": "Name of a parent family hub. Usually empty for systems."
    },
    "bot_metadata": {
      "type": "object",
      "description": "Automation bookkeeping written by the content bots (not hand-authored). select_oldest_files.sh reads last_improved to skip recently-improved files.",
      "additionalProperties": true,
      "properties": {
        "last_improved": { "type": "string", "description": "ISO date (YYYY-MM-DD) of the last bot edit" },
        "optimization_pass": { "type": "string" },
        "last_improved_by": { "type": "string" }
      }
    },
    "sameAs": {
      "type": "array",
      "description": "Authoritative external URLs for THIS system (Wikipedia/Wikidata). schema.org sameAs. See docs/Synonyms.md.",
      "uniqueItems": true,
      "items": { "type": "string", "format": "uri" }
    },
    "disambiguations": {
      "type": "array",
      "description": "False-synonym callouts. Renders 'Often confused with X — reason'. See docs/Synonyms.md.",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "reason"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 10 }
        }
      }
    },
    "system_type": {
      "type": "string",
      "enum": [
        "Attack System",
        "Defense System",
        "Submission Chain",
        "Passing System",
        "Guard System",
        "Control System",
        "Competition Strategy",
        "Training Methodology"
      ]
    },
    "difficulty_level": {
      "type": "string",
      "enum": [
        "Beginner",
        "Intermediate",
        "Advanced",
        "Expert"
      ]
    },
    "summary": {
      "type": "string",
      "description": "One-sentence, self-contained definition that leads the page (answer-first for AI/featured snippets). ~15-40 words. If present, the overview should NOT repeat it.",
      "minLength": 30,
      "maxLength": 300
    },
    "overview": {
      "type": "string",
      "description": "2-3 paragraph system description (400+ characters). LEAD with a self-contained one-sentence definition that directly answers 'what is X' before adding history/context — AI answer engines quote the first sentence. If a `summary` field is present, start the overview with context instead, to avoid duplicating it.",
      "minLength": 400,
      "examples": [
        "The Kimura Trap System is a comprehensive control and submission framework..."
      ]
    },
    "key_principles": {
      "type": "array",
      "description": "Core principles (5-8 items)",
      "minItems": 5,
      "maxItems": 8,
      "items": {
        "type": "string"
      }
    },
    "key_components": {
      "type": "array",
      "description": "Main system elements (minimum 4, 50+ character descriptions)",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component_name",
          "description",
          "purpose"
        ],
        "properties": {
          "component_name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 50
          },
          "purpose": {
            "type": "string"
          }
        }
      }
    },
    "implementation_sequence": {
      "type": "array",
      "description": "Step-by-step implementation (minimum 5)",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_number",
          "phase",
          "description"
        ],
        "properties": {
          "step_number": {
            "type": "integer",
            "minimum": 1
          },
          "phase": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "key_points": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "common_obstacles": {
      "type": "array",
      "description": "Implementation challenges (minimum 4)",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "obstacle",
          "solution"
        ],
        "properties": {
          "obstacle": {
            "type": "string"
          },
          "solution": {
            "type": "string"
          }
        }
      }
    },
    "assessment_metrics": {
      "type": "array",
      "description": "Proficiency measurement (minimum 4)",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_name",
          "description",
          "proficiency_indicators"
        ],
        "properties": {
          "metric_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "proficiency_indicators": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "training_methodology": {
      "type": "object",
      "description": "How to train the system",
      "additionalProperties": false,
      "required": [
        "drilling_approach",
        "progression_path",
        "common_mistakes"
      ],
      "properties": {
        "drilling_approach": {
          "type": "string",
          "description": "Effective drilling method (200+ characters)",
          "minLength": 200
        },
        "progression_path": {
          "type": "array",
          "description": "Stages of system mastery (minimum 4)",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "focus"
            ],
            "properties": {
              "stage": {
                "type": "string"
              },
              "focus": {
                "type": "string"
              },
              "timeframe": {
                "type": "string"
              }
            }
          }
        },
        "common_mistakes": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "related_content": {
      "type": "array",
      "description": "Related systems/positions/principles (10-30 for comprehensive SEO)",
      "minItems": 10,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "content_type",
          "relationship"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "content_type": {
            "type": "string",
            "enum": [
              "System",
              "Position",
              "Transition",
              "Submission",
              "Principle"
            ]
          },
          "relationship": {
            "type": "string"
          }
        }
      }
    },
    "flashcards": {
      "type": "array",
      "description": "Q&A flashcards for self-assessment and SRS training (optional, 6-12 recommended)",
      "minItems": 0,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "answer"
        ],
        "properties": {
          "question": {
            "type": "string",
            "pattern": ".*\\?$",
            "description": "Question about the system, its components, or application"
          },
          "answer": {
            "type": "string",
            "minLength": 50,
            "description": "Detailed answer (50+ characters)"
          }
        }
      }
    }
  }
}
