{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BJJ Systems Guide Schema",
  "description": "Source-grounded independent study guides; optional legacy body fields remain supported.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "tags",
    "system_type",
    "difficulty_level",
    "overview",
    "related_content",
    "summary",
    "guide"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "System name (must match filename without .json)",
      "minLength": 1,
      "examples": [
        "Kimura Trap System",
        "Danaher Leg Lock System"
      ]
    },
    "description": {
      "type": "string",
      "description": "Accurate description without keyword padding.",
      "minLength": 1,
      "examples": [
        "Master Kimura Trap System in BJJ. Comprehensive framework connecting control to submissions and back takes. Danaher's systematic approach."
      ]
    },
    "tags": {
      "type": "array",
      "description": "Relevant content tags.",
      "items": {
        "type": "string"
      },
      "examples": [
        [
          "bjj",
          "system",
          "kimura",
          "submission-chain"
        ]
      ]
    },
    "aliases": {
      "type": "array",
      "description": "Strict synonyms — other names for THIS EXACT system. Examples: ['DDS', 'Modern Leg Locks'] for Danaher Leg Lock System. See docs/Synonyms.md.",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "family": {
      "type": "string",
      "description": "Name of a parent family hub. Usually empty for systems."
    },
    "bot_metadata": {
      "type": "object",
      "description": "Automation bookkeeping written by the content bots (not hand-authored). select_oldest_files.sh reads last_improved to skip recently-improved files.",
      "additionalProperties": true,
      "properties": {
        "last_improved": {
          "type": "string",
          "description": "ISO date (YYYY-MM-DD) of the last bot edit"
        },
        "optimization_pass": {
          "type": "string"
        },
        "last_improved_by": {
          "type": "string"
        }
      }
    },
    "sameAs": {
      "type": "array",
      "description": "Authoritative external URLs for THIS system (Wikipedia/Wikidata). schema.org sameAs. See docs/Synonyms.md.",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "disambiguations": {
      "type": "array",
      "description": "False-synonym callouts. Renders 'Often confused with X — reason'. See docs/Synonyms.md.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "reason"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "system_type": {
      "type": "string",
      "enum": [
        "Attack System",
        "Defense System",
        "Submission Chain",
        "Passing System",
        "Guard System",
        "Control System",
        "Competition Strategy",
        "Training Methodology"
      ]
    },
    "difficulty_level": {
      "type": "string",
      "enum": [
        "Beginner",
        "Intermediate",
        "Advanced",
        "Expert"
      ]
    },
    "summary": {
      "type": "string",
      "description": "One-sentence, self-contained definition that leads the page (answer-first for AI/featured snippets). ~15-40 words. If present, the overview should NOT repeat it.",
      "minLength": 1,
      "maxLength": 300
    },
    "overview": {
      "type": "string",
      "description": "Brief context distinct from the summary; no unsupported history or biography.",
      "minLength": 1,
      "examples": [
        "The Kimura Trap System is a comprehensive control and submission framework..."
      ]
    },
    "key_principles": {
      "type": "array",
      "description": "Optional source-supported legacy content.",
      "items": {
        "type": "string"
      }
    },
    "key_components": {
      "type": "array",
      "description": "Optional source-supported legacy content.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component_name",
          "description",
          "purpose"
        ],
        "properties": {
          "component_name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string"
          }
        }
      }
    },
    "implementation_sequence": {
      "type": "array",
      "description": "Optional source-supported legacy content.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_number",
          "phase",
          "description"
        ],
        "properties": {
          "step_number": {
            "type": "integer",
            "minimum": 1
          },
          "phase": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "key_points": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "common_obstacles": {
      "type": "array",
      "description": "Optional source-supported legacy content.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "obstacle",
          "solution"
        ],
        "properties": {
          "obstacle": {
            "type": "string"
          },
          "solution": {
            "type": "string"
          }
        }
      }
    },
    "assessment_metrics": {
      "type": "array",
      "description": "Optional source-supported legacy content.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_name",
          "description",
          "proficiency_indicators"
        ],
        "properties": {
          "metric_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "proficiency_indicators": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "training_methodology": {
      "type": "object",
      "description": "Optional source-supported legacy content.",
      "additionalProperties": false,
      "required": [
        "drilling_approach",
        "progression_path",
        "common_mistakes"
      ],
      "properties": {
        "drilling_approach": {
          "type": "string",
          "description": "Optional legacy drill supported by inspected public instruction.",
          "minLength": 1
        },
        "progression_path": {
          "type": "array",
          "description": "Optional source-supported study progression; never invent mastery timelines.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "focus"
            ],
            "properties": {
              "stage": {
                "type": "string"
              },
              "focus": {
                "type": "string"
              },
              "timeframe": {
                "type": "string"
              }
            }
          }
        },
        "common_mistakes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "related_content": {
      "type": "array",
      "description": "Preserve graph membership; relationships distinguish related material from advertised course coverage.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "content_type",
          "relationship"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "content_type": {
            "type": "string",
            "enum": [
              "System",
              "Position",
              "Transition",
              "Submission",
              "Principle"
            ]
          },
          "relationship": {
            "type": "string"
          }
        }
      }
    },
    "flashcards": {
      "type": "array",
      "description": "Optional source-supported legacy content.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "answer"
        ],
        "properties": {
          "question": {
            "type": "string",
            "pattern": ".*\\?$",
            "description": "Question about the system, its components, or application"
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "description": "Self-contained source-supported answer."
          },
          "distractors": {
            "type": "object",
            "additionalProperties": false,
            "description": "Optional authored MC distractor tiers (graded options): plausible = nearly-right beginner beliefs, trap = dangerous misconceptions. Rendered by the Neural app's multiple-choice mode; runtime pooling is the fallback when absent.",
            "properties": {
              "plausible": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "trap": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            }
          },
          "answer_line": {
            "type": "string",
            "maxLength": 60,
            "description": "Optional one-line MC answer / recall cue (<=36 chars target); the full 'answer' stays as the post-reveal detail."
          }
        }
      }
    },
    "products": {
      "type": "array",
      "description": "Verified canonical courses; never author referrals, tracking queries or placeholder URLs.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "course_url",
          "link_status",
          "link_checked"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable kebab-case identifier, unique across all products"
          },
          "link_status": {
            "type": "string",
            "enum": [
              "live",
              "dead",
              "unverified"
            ],
            "description": "Availability verification, independent of affiliate configuration; only live products render."
          },
          "link_checked": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "Date this exact course listing was actually checked."
          },
          "title": {
            "type": "string"
          },
          "instructor": {
            "type": "string"
          },
          "vendor": {
            "type": "string",
            "description": "Affiliate vendor, e.g. BJJFanatics"
          },
          "image": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://[^\\s]+$",
            "description": "Verified cover image from this exact official product listing; shown while its intro loads or when no intro is available."
          },
          "blurb": {
            "type": "string",
            "description": "Measured explanation of how the verified course relates to this system."
          },
          "price_usd": {
            "type": "number",
            "description": "Optional reference data, never rendered; check the vendor for current prices."
          },
          "covers": {
            "type": "array",
            "description": "Optional member-node display names this product specifically teaches",
            "items": {
              "type": "string"
            }
          },
          "best_for": {
            "type": "string",
            "description": "Who this course suits, including any limits to its coverage of this system."
          },
          "study_focus": {
            "type": "string",
            "description": "Where to begin in the verified course syllabus."
          },
          "practice_tip": {
            "type": "string",
            "description": "Source-supported study or practice guidance; never invent physical drills from a listing."
          },
          "course_url": {
            "type": "string",
            "format": "uri",
            "description": "Verified canonical course URL without tracking, query or fragment.",
            "pattern": "^https://[^?#\\s]+$"
          }
        }
      }
    },
    "guide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "course_companion",
            "topic_guide"
          ]
        },
        "display_title": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fits": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "consider_alternative_if": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "prerequisites": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            }
          },
          "required": [
            "fits",
            "consider_alternative_if"
          ]
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "includes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "limits": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "includes",
            "limits"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://[^\\s]+$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "official_listing",
                  "public_instruction",
                  "ruleset",
                  "community_discussion"
                ]
              },
              "checked_on": {
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "note": {
                "type": "string",
                "minLength": 1
              },
              "viewed_range": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "url",
              "title",
              "kind",
              "checked_on",
              "note"
            ]
          }
        },
        "preview": {
          "type": "object",
          "description": "Exact official product introduction, preferably its primary trailer. Preserve the published embed URL; renderers apply muted autoplay and inline controls. Omit when no exact intro is available and use the verified product cover instead.",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "enum": [
                "bunny",
                "youtube"
              ]
            },
            "embed_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://[^\\s]+$"
            },
            "source_id": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "sample",
                "trailer"
              ]
            },
            "checked_on": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "content_reviewed": {
              "type": "boolean"
            },
            "playback_verified_on": {
              "type": "array",
              "description": "Historical playback audit evidence only. An empty array does not prevent embedding a valid official player.",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^https?://[^/\\s?#]+$"
              }
            }
          },
          "required": [
            "provider",
            "embed_url",
            "source_id",
            "title",
            "kind",
            "checked_on",
            "content_reviewed",
            "playback_verified_on"
          ]
        },
        "alternatives": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "system",
              "reason"
            ],
            "properties": {
              "system": {
                "type": "string",
                "minLength": 1,
                "description": "Exact existing System source name, never a guessed slug or URL."
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "required": [
        "kind",
        "display_title",
        "audience",
        "coverage",
        "sources"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "course_companion"
              }
            }
          },
          "then": {
            "properties": {
              "sources": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
