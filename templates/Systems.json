{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BJJ Systems Template Schema V3",
  "description": "Standardized JSON schema for BJJ system pages - strict 10-section structure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "tags",
    "system_type",
    "difficulty_level",
    "overview",
    "key_principles",
    "key_components",
    "implementation_sequence",
    "common_obstacles",
    "assessment_metrics",
    "training_methodology",
    "related_content"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "System name (must match filename without .json)",
      "minLength": 3,
      "examples": [
        "Kimura Trap System",
        "Danaher Leg Lock System"
      ]
    },
    "description": {
      "type": "string",
      "description": "SEO meta description 150-160 characters",
      "minLength": 140,
      "maxLength": 180,
      "examples": [
        "Master Kimura Trap System in BJJ. Comprehensive framework connecting control to submissions and back takes. Danaher's systematic approach."
      ]
    },
    "tags": {
      "type": "array",
      "description": "Content tags (minimum 3)",
      "minItems": 3,
      "items": {
        "type": "string"
      },
      "examples": [
        [
          "bjj",
          "system",
          "kimura",
          "submission-chain"
        ]
      ]
    },
    "system_type": {
      "type": "string",
      "enum": [
        "Attack System",
        "Defense System",
        "Submission Chain",
        "Passing System",
        "Guard System",
        "Control System",
        "Competition Strategy",
        "Training Methodology"
      ]
    },
    "difficulty_level": {
      "type": "string",
      "enum": [
        "Beginner",
        "Intermediate",
        "Advanced",
        "Expert"
      ]
    },
    "overview": {
      "type": "string",
      "description": "2-3 paragraph system description (400+ characters)",
      "minLength": 400,
      "examples": [
        "The Kimura Trap System is a comprehensive control and submission framework..."
      ]
    },
    "key_principles": {
      "type": "array",
      "description": "Core principles (5-8 items)",
      "minItems": 5,
      "maxItems": 8,
      "items": {
        "type": "string"
      }
    },
    "key_components": {
      "type": "array",
      "description": "Main system elements (minimum 4, 50+ character descriptions)",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component_name",
          "description",
          "purpose"
        ],
        "properties": {
          "component_name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 50
          },
          "purpose": {
            "type": "string"
          }
        }
      }
    },
    "implementation_sequence": {
      "type": "array",
      "description": "Step-by-step implementation (minimum 5)",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_number",
          "phase",
          "description"
        ],
        "properties": {
          "step_number": {
            "type": "integer",
            "minimum": 1
          },
          "phase": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "key_points": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "common_obstacles": {
      "type": "array",
      "description": "Implementation challenges (minimum 4)",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "obstacle",
          "solution"
        ],
        "properties": {
          "obstacle": {
            "type": "string"
          },
          "solution": {
            "type": "string"
          }
        }
      }
    },
    "assessment_metrics": {
      "type": "array",
      "description": "Proficiency measurement (minimum 4)",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_name",
          "description",
          "proficiency_indicators"
        ],
        "properties": {
          "metric_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "proficiency_indicators": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "training_methodology": {
      "type": "object",
      "description": "How to train the system",
      "additionalProperties": false,
      "required": [
        "drilling_approach",
        "progression_path",
        "common_mistakes"
      ],
      "properties": {
        "drilling_approach": {
          "type": "string",
          "description": "Effective drilling method (200+ characters)",
          "minLength": 200
        },
        "progression_path": {
          "type": "array",
          "description": "Stages of system mastery (minimum 4)",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "focus"
            ],
            "properties": {
              "stage": {
                "type": "string"
              },
              "focus": {
                "type": "string"
              },
              "timeframe": {
                "type": "string"
              }
            }
          }
        },
        "common_mistakes": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "related_content": {
      "type": "array",
      "description": "Related systems/positions/principles (10-30 for comprehensive SEO)",
      "minItems": 10,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "content_type",
          "relationship"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "content_type": {
            "type": "string",
            "enum": [
              "System",
              "Position",
              "Transition",
              "Submission",
              "Principle"
            ]
          },
          "relationship": {
            "type": "string"
          }
        }
      }
    }
  }
}
