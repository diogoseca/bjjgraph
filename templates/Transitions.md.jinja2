{# BJJ Transition Template V4 - Jinja2 #}
{# Generates markdown from TEMPLATE.json data with auto-generated schema markup #}
{# Supports outcomes-based schema with from_position and multiple outcome probabilities #}
{# A/B Testing: variant-a-show/variant-b-hide CSS classes for section testing #}

---
title: "{{name}} | BJJ Technique | BJJ Graph"
description: "{{description}}"
---

{# PostHog A/B Testing Metadata #}
<body data-content-type="transitions">

<!-- Schema Markup - Auto-generated from JSON -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": {{ ("How to Execute " ~ (name) ~ " in BJJ") | jsonstr }},
  {#- the loop is built OUTSIDE the string so jsonstr can quote the whole value; ', '.join == the
      old per-item `', ' if not loop.last` joiner #}
  {%- set _outcome_bits = [] %}
  {%- for outcome in outcomes %}{% set _ = _outcome_bits.append((outcome.to) ~ " (" ~ (outcome.probability) ~ "%)") %}{% endfor %}
  "description": {{ ("Step-by-step guide for " ~ (name) ~ " from " ~ (from_position) ~ ". Possible outcomes: " ~ (_outcome_bits | join(", ")) ~ ".") | jsonstr }},
  "step": [
    {%- for step in execution_steps[:8] %}
    {
      "@type": "HowToStep",
      "name": {{ step.action | jsonstr }},
      "text": {{ step.description | jsonstr }},
      "position": {{loop.index}}
    }{{ "," if not loop.last else "" }}
    {%- endfor %}
  ],
  "tool": ["BJJ Gi or No-Gi attire", "Training partner", "Mat space"],
  "totalTime": "PT5M"
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for qa in flashcards[:6] %}
    {
      "@type": "Question",
      "name": {{ qa.question | jsonstr }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ qa.answer | jsonstr }}
      }
    }{{ "," if not loop.last else "" }}
    {%- endfor %}
  ]
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": {{ name | jsonstr }},
  "description": {{ description | jsonstr }},
  "url": {{ ("https://bjjgraph.org/Transitions/" ~ (name.replace(' ', '-'))) | jsonstr }},
  "isPartOf": {
    "@type": "WebSite",
    "name": "BJJ Graph",
    "url": "https://bjjgraph.org"
  }
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://bjjgraph.org/"},
    {"@type": "ListItem", "position": 2, "name": "Transitions", "item": "https://bjjgraph.org/Transitions/"},
    {"@type": "ListItem", "position": 3, "name": {{ name | jsonstr }}, "item": {{ ("https://bjjgraph.org/Transitions/" ~ (name.replace(' ', '-'))) | jsonstr }}}
  ]
}
</script>

{% if summary %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  "name": {{ name | jsonstr }},
  "description": {{ summary | jsonstr }},
  "inDefinedTermSet": "https://bjjgraph.org/Transitions/"
}
</script>
{% endif %}

{# Flexbox wrapper for A/B testing #}
<main class="content-wrapper" style="display: flex; flex-direction: column;">

<section id="overview" class="content-section">

{% if summary %}**{{ summary }}**

{% endif -%}
{{ overview }}

**From Position**: [[{{ resolve(from_position) }}]]
**Success Rate**: {{success_rate}}%

</section>

<section id="possible-outcomes" class="content-section">

## Possible Outcomes

| Result | Position | Probability |
|--------|----------|-------------|
{% for outcome in outcomes -%}
| {{ outcome.result | capitalize }} | [[{{ resolve(outcome.to) }}]] | {{ outcome.probability }}% |
{% endfor %}

</section>

{% if conditions %}
<section id="conditions" class="content-section">

## Conditions for Attempt
{% for condition in conditions -%}
- {{ condition }}
{% endfor %}

</section>
{% endif %}

<section id="key-principles" class="content-section">

## Key Principles
{% for principle in key_principles -%}
- {{ principle }}
{% endfor %}

</section>

<section id="setup-requirements" class="content-section">

## Prerequisites
{% for req in setup_requirements -%}
- {{req}}
{% endfor %}

</section>

<section id="execution-steps" class="content-section">

## Execution Steps
{% for step in execution_steps -%}
{{step.step_number}}. **{{step.action}}**: {{step.description}}
{% endfor %}

</section>

<section id="common-counters" class="content-section">

## Opponent Counters
{% for counter in common_counters -%}
- **{{counter.counter}}** (Effectiveness: {{counter.effectiveness}}){% if counter.your_response %} - Your Response: {{counter.your_response}}{% endif %}
{% endfor %}

</section>

<section id="common-mistakes" class="content-section hide-minimal">

## Common Mistakes
{% for error in common_errors -%}
- **Mistake**: {{error.error}}
  - **Consequence**: {{error.consequence}}
  - **Correction**: {{error.correction}}
{% endfor %}

</section>

<section id="training-progressions" class="content-section hide-minimal">

## Training Progressions
{% for progression in training_progressions -%}
**{{progression.phase}}** - {{progression.focus}}
{{progression.description}}

{% endfor %}

</section>

<section id="variants-and-adaptations" class="content-section hide-minimal">

## Variations
{% for variant in variants_and_adaptations -%}
**{{variant.variant_name}}**: {{variant.description}}{% if variant.when_to_use %} (When to use: {{variant.when_to_use}}){% endif %}

{% endfor %}

</section>

<section id="knowledge-assessment" class="content-section">

## Test Your Knowledge
{% for qa in flashcards -%}
**Q{{loop.index}}**: {{qa.question}}
**A**: {{qa.answer}}

{% endfor %}

</section>

<section id="safety-considerations" class="content-section">

## Safety Considerations

{{safety_considerations}}

</section>

<section id="position-integration" class="content-section">

## Position Integration

{{position_integration}}

</section>

<section id="related-content" class="content-section">

## Related Techniques

{% for item in related_content -%}
- [[{{ resolve(item.name) }}]] - {{item.relationship}}
{% endfor %}

</section>

</main>
